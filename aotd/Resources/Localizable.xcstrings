    "%lld days free, then %@ per year. Auto-renews until cancelled in Settings at least a day before each renewal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@days@, danach %2$@ pro Jahr. Verlängert sich automatisch, bis du mindestens einen Tag vor der Verlängerung in den Einstellungen kündigst."
          },
          "substitutions": {
            "days": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Tag gratis"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Tage gratis"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@days@, después %2$@ al año. Se renueva automáticamente hasta que lo canceles en Ajustes al menos un día antes de cada renovación."
          },
          "substitutions": {
            "days": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg día gratis"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg días gratis"
                    }
                  }
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@days@, puis %2$@ par an. Renouvellement automatique jusqu'à résiliation dans Réglages, au moins un jour avant chaque échéance."
          },
          "substitutions": {
            "days": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg jour offert"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg jours offerts"
                    }
                  }
                }
              }
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@days@, poi %2$@ all'anno. Si rinnova automaticamente finché non annulli in Impostazioni almeno un giorno prima di ogni rinnovo."
          },
          "substitutions": {
            "days": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg giorno gratis"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg giorni gratis"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@days@、その後は年額%2$@。各更新日の1日前までに設定で解約しない限り自動更新されます。"
          },
          "substitutions": {
            "days": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg日間無料"
                    }
                  }
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@days@ 후 연 %2$@. 갱신일 최소 하루 전에 설정에서 취소하지 않으면 자동으로 갱신됩니다."
          },
          "substitutions": {
            "days": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg일 무료"
                    }
                  }
                }
              }
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@days@, depois %2$@ por ano. Renova automaticamente até você cancelar nos Ajustes pelo menos um dia antes de cada renovação."
          },
          "substitutions": {
            "days": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg dia grátis"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg dias grátis"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
