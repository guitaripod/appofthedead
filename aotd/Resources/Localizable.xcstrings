    "%@ per month. Auto-renews until cancelled in Settings at least a day before each renewal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro Monat. Verlängert sich automatisch, bis du mindestens einen Tag vor der Verlängerung in den Einstellungen kündigst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al mes. Se renueva automáticamente hasta que lo canceles en Ajustes al menos un día antes de cada renovación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par mois. Renouvellement automatique jusqu'à résiliation dans Réglages, au moins un jour avant chaque échéance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al mese. Si rinnova automaticamente finché non annulli in Impostazioni almeno un giorno prima di ogni rinnovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月額%@。各更新日の1日前までに設定で解約しない限り自動更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월 %@. 갱신일 최소 하루 전에 설정에서 취소하지 않으면 자동으로 갱신됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por mês. Renova automaticamente até você cancelar nos Ajustes pelo menos um dia antes de cada renovação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月%@。除非在每次续订前至少一天于「设置」中取消，否则将自动续订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月 %@。除非在每次續訂前至少一天於「設定」中取消，否則將自動續訂。"
          }
        }
      }
    },
    "%@ per year. Auto-renews until cancelled in Settings at least a day before each renewal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro Jahr. Verlängert sich automatisch, bis du mindestens einen Tag vor der Verlängerung in den Einstellungen kündigst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al año. Se renueva automáticamente hasta que lo canceles en Ajustes al menos un día antes de cada renovación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par an. Renouvellement automatique jusqu'à résiliation dans Réglages, au moins un jour avant chaque échéance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ all'anno. Si rinnova automaticamente finché non annulli in Impostazioni almeno un giorno prima di ogni rinnovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年額%@。各更新日の1日前までに設定で解約しない限り自動更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연 %@. 갱신일 최소 하루 전에 설정에서 취소하지 않으면 자동으로 갱신됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por ano. Renova automaticamente até você cancelar nos Ajustes pelo menos um dia antes de cada renovação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每年%@。除非在每次续订前至少一天于「设置」中取消，否则将自动续订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每年 %@。除非在每次續訂前至少一天於「設定」中取消，否則將自動續訂。"
          }
        }
      }
    },
    "%@ runs entirely on your iPhone. About %@ GB, downloaded once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ läuft vollständig auf deinem iPhone. Etwa %2$@ GB, einmalig geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ funciona por completo en tu iPhone. Unos %2$@ GB, descargados una sola vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fonctionne entièrement sur votre iPhone. Environ %2$@ Go, téléchargés une seule fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ funziona interamente sul tuo iPhone. Circa %2$@ GB, scaricati una sola volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はすべてiPhone上で動作します。約%2$@ GB、ダウンロードは一度きりです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 전부 iPhone에서 실행됩니다. 약 %2$@GB이며 한 번만 다운로드합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %1$@ roda inteiramente no seu iPhone. Cerca de %2$@ GB, baixados uma única vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@完全在你的 iPhone 上运行。约 %2$@ GB，只需下载一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@完全在你的 iPhone 上執行。約 %2$@ GB，只需下載一次。"
          }
        }
      }
    },
