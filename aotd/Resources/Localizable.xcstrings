            "value": "L'Eterno, coscienza cosmica"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠なるもの、宇宙意識"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영원자, 우주 의식"
          }
        },
        "pt-BR": {
          "stringUnit": {
