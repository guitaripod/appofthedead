    "This will reset all your progress for %@. You'll lose your XP and completed lessons.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird dein gesamter Fortschritt für %@ zurückgesetzt. Deine XP und abgeschlossenen Lektionen gehen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restablecerá todo tu progreso en %@. Perderás tus XP y las lecciones completadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute votre progression sur %@ sera réinitialisée. Vous perdrez vos XP et vos leçons terminées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i tuoi progressi in %@ verranno azzerati. Perderai gli XP e le lezioni completate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の進捗がすべてリセットされます。獲得した XP と完了したレッスンは失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 진행 상황이 모두 재설정됩니다. 획득한 XP와 완료한 레슨을 잃게 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto vai redefinir todo o seu progresso em %@. Você perderá seus XP e as lições concluídas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将重置你在%@的全部进度。你将失去已获得的 XP 与已完成的课程。"
