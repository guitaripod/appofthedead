    "Annual plan starts at %@/year. Cancel anytime before.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach %@/Jahr. Vorher jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, %@/año. Cancela cuando quieras antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis %@/an. Résiliable à tout moment avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi %@/anno. Puoi annullare in qualsiasi momento prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以降は年額%@。それまでならいつでも解約できます。"
