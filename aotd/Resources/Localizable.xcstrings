        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭해서 선택한 뒤 다른 열의 항목을 탭하면 짝이 됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para selecionar e depois toque em um item da outra coluna para formar um par"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点选择，然后轻点另一列中的项目即可配对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下以選取，再點一下另一欄中的項目即可配對"
          }
        }
      }
    },
