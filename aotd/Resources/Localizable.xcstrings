    "The oracle's wisdom could not be reached at this time. Please try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Weisheit des Orakels war gerade nicht erreichbar. Bitte versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sabiduría del Oráculo no estuvo al alcance en este momento. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sagesse de l'Oracle est restée hors d'atteinte. Veuillez réessayer plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La saggezza dell'Oracolo non è stata raggiungibile in questo momento. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オラクルの叡智に今は届きませんでした。しばらくしてからお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 오라클의 지혜에 닿지 못했습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sabedoria do Oráculo ficou fora de alcance neste momento. Tente novamente mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此刻未能触及神谕的智慧。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此刻未能觸及神諭的智慧。請稍後再試。"
          }
        }
      }
    },
    "The summoning was interrupted. Check your connection and try again — progress is kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beschwörung wurde unterbrochen. Prüfe deine Verbindung und versuche es erneut – der Fortschritt bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La invocación se interrumpió. Comprueba tu conexión e inténtalo de nuevo: el progreso se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'invocation a été interrompue. Vérifiez votre connexion et réessayez — la progression est conservée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'evocazione è stata interrotta. Controlla la connessione e riprova: i progressi restano salvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "召喚が中断されました。接続を確認してもう一度お試しください。進捗は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소환이 중단되었습니다. 연결을 확인하고 다시 시도하세요. 진행 상황은 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A invocação foi interrompida. Verifique sua conexão e tente de novo — o progresso é mantido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "召唤被中断。请检查网络连接后重试——进度会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "召喚被中斷。請檢查網路連線後再試一次——進度會保留。"
          }
        }
      }
    },
