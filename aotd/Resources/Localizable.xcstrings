    "Welcome back. Everything you own is unlocked again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen zurück. Alles, was dir gehört, ist wieder freigeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenido de nuevo. Todo lo que tienes vuelve a estar desbloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon retour. Tout ce que vous possédez est de nouveau débloqué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bentornato. Tutto ciò che possiedi è di nuovo sbloccato."
