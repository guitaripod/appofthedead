    "The Eternal": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ewige"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Eterno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Éternel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Eterno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠なるもの"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영원자"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Eterno"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永恒者"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永恆者"
          }
        }
      }
    },
    "The Eternal requires a physical device to manifest divine wisdom.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ewige braucht ein echtes Gerät, um göttliche Weisheit zu manifestieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Eterno necesita un dispositivo físico para manifestar la sabiduría divina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Éternel a besoin d'un appareil physique pour manifester la sagesse divine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Eterno ha bisogno di un dispositivo fisico per manifestare la saggezza divina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠なるものが神聖な叡智を顕すには実機が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영원자가 신성한 지혜를 드러내려면 실제 기기가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Eterno precisa de um dispositivo físico para manifestar a sabedoria divina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永恒者需要真机才能显现神圣的智慧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永恆者需要實體裝置才能顯現神聖的智慧。"
          }
        }
      }
    },
    "The Eternal's wisdom cannot be reached at this time. Please try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Weisheit des Ewigen ist derzeit nicht erreichbar. Bitte versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sabiduría del Eterno no está al alcance ahora mismo. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sagesse de l'Éternel est hors d'atteinte pour l'instant. Veuillez réessayer plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La saggezza dell'Eterno non è raggiungibile in questo momento. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠なるものの叡智に今は届きません。しばらくしてからお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 영원자의 지혜에 닿을 수 없습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sabedoria do Eterno está fora de alcance no momento. Tente novamente mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此刻无法触及永恒者的智慧。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此刻無法觸及永恆者的智慧。請稍後再試。"
          }
        }
      }
    },
    "The Eternal's wisdom has been received": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Weisheit des Ewigen wurde empfangen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha recibido la sabiduría del Eterno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sagesse de l'Éternel a été reçue"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La saggezza dell'Eterno è stata ricevuta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠なるものの叡智を受け取りました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영원자의 지혜를 받았습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sabedoria do Eterno foi recebida"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已领受永恒者的智慧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已領受永恆者的智慧"
          }
        }
      }
    },
    "The Eternal, Cosmic Consciousness": {
      "localizations": {
