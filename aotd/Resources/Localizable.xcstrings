    "Sign in to Game Center in the Settings app to climb the leaderboards and earn honors across the realms of the dead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich in den Einstellungen bei Game Center an, um in den Bestenlisten aufzusteigen und Ehrungen in den Reichen der Toten zu verdienen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en Game Center desde Ajustes para escalar en las clasificaciones y ganar honores en los reinos de los muertos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à Game Center dans Réglages pour grimper au classement et gagner des honneurs dans les royaumes des morts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a Game Center da Impostazioni per scalare le classifiche e guadagnare onori nei regni dei morti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "死者の国のリーダーボードで競い、栄誉を得るには、設定 App で Game Center にサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "죽은 자의 세계에서 리더보드를 오르고 명예를 얻으려면 설정 앱에서 Game Center에 로그인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login no Game Center pelos Ajustes para subir nos rankings e ganhar honras nos reinos dos mortos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「设置」App 中登录 Game Center，在亡者的国度中攀登排行榜、赢取荣誉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」App 中登入 Game Center，在亡者的國度中攀登排行榜、贏取榮譽。"
          }
        }
      }
    },
