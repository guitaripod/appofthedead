        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이후 연 %@. 그 전에 언제든 취소할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois, %@/ano. Cancele quando quiser antes disso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后按 %@/年续订。在此之前可随时取消。"
