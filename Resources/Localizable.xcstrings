    "Written by AI on this iPhone in the voice of each tradition. It can be wrong and is not religious guidance.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrevet af AI på denne iPhone i hver traditions stemme. Det kan være forkert, og det er ikke religiøs vejledning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von einer KI auf diesem iPhone in der Stimme jeder Tradition geschrieben. Sie kann sich irren und ist keine religiöse Weisung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrito por una IA en este iPhone con la voz de cada tradición. Puede equivocarse y no es una guía religiosa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoäly kirjoitti tämän tällä iPhonella kunkin perinteen äänellä. Se voi olla väärässä eikä ole uskonnollista ohjausta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit par une IA sur cet iPhone, avec la voix de chaque tradition. Elle peut se tromper et ne remplace pas un guide religieux."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrifað af gervigreind á þessum iPhone í rödd hverrar hefðar. Það getur verið rangt og er ekki trúarleg leiðsögn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scritto da un'IA su questo iPhone con la voce di ogni tradizione. Può sbagliare e non è una guida religiosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhone上のAIが各伝統の語り口で書いた回答です。誤りを含むことがあり、宗教的な指導ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 AI가 각 전통의 목소리로 쓴 답입니다. 틀릴 수 있으며 종교적 지도가 아닙니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrevet av KI på denne iPhonen i stemmen til hver tradisjon. Den kan ta feil og er ikke religiøs veiledning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisane przez AI na tym iPhonie głosem każdej tradycji. Może się mylić i nie jest wskazówką religijną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrito por uma IA neste iPhone com a voz de cada tradição. Pode errar e não é orientação religiosa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriven av AI på den här iPhonen i varje traditions röst. Den kan ha fel och är inte religiös vägledning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由此 iPhone 上的 AI 以各传统的口吻写成。可能出错，并非宗教指导。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由此 iPhone 上的 AI 以各傳統的口吻寫成。可能出錯，並非宗教指導。"
          }
        }
      }
    },
