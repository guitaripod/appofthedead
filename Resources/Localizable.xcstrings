    "%lld days free, then %@ per year. Auto-renews until cancelled in Settings at least a day before each renewal.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-dages gratis, derefter %@ pr. år. Fornyes automatisk, medmindre du opsiger i Indstillinger senest en dag før hver fornyelse."
          },
          "substitutions": {
            "days": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg dag gratis"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg dage gratis"
                    }
                  }
                }
              }
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@days@, danach %2$@ pro Jahr. Verlängert sich automatisch, bis du mindestens einen Tag vor der Verlängerung in den Einstellungen kündigst."
          },
          "substitutions": {
            "days": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Tag gratis"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Tage gratis"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@days@, después %2$@ al año. Se renueva automáticamente hasta que lo canceles en Ajustes al menos un día antes de cada renovación."
          },
          "substitutions": {
            "days": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg día gratis"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg días gratis"
                    }
                  }
                }
              }
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@days@, sen jälkeen %2$@ vuodessa. Uusiutuu automaattisesti, kunnes peruutat asetuksissa vähintään päivää ennen jokaista uusiutumista."
          },
          "substitutions": {
            "days": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg päivä ilmaiseksi"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg päivää ilmaiseksi"
                    }
                  }
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@days@, puis %2$@ par an. Renouvellement automatique jusqu'à résiliation dans Réglages, au moins un jour avant chaque échéance."
          },
          "substitutions": {
            "days": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
