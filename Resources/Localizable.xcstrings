    "Charon holds out his hand at the river Styx. The fare is one coin, and you have exactly one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Charon hält am Styx die Hand auf. Der Fahrpreis ist eine Münze, und du hast genau eine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caronte tiende la mano en el río Estigia. El pasaje cuesta una moneda, y tienes exactamente una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charon tend la main au bord du Styx. Le passage coûte une pièce, et vous en avez exactement une."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caronte tende la mano sul fiume Stige. Il pedaggio è una moneta, e tu ne hai esattamente una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステュクス川のほとりで、カロンが手を差し出します。渡し賃は一枚の硬貨。あなたは一枚だけ持っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카론이 스틱스 강가에서 손을 내밉니다. 뱃삯은 동전 한 닢, 당신에게는 딱 한 닢이 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Charon wyciąga rękę nad rzeką Styks. Opłata to jedna moneta, a ty masz dokładnie jedną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caronte estende a mão no rio Estige. A passagem custa uma moeda, e você tem exatamente uma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡戎在冥河边伸出手。船资是一枚硬币，而你恰好只有一枚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡戎在冥河伸出手。船資是一枚硬幣，而你恰好只有一枚。"
          }
        }
      }
    },
