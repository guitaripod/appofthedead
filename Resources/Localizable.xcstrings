            "value": "阿努比斯"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阿努比斯"
          }
        }
      }
    },
    "Anubis lays your heart on the scale. Opposite it, the feather of Ma'at. Any last words?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis lægger dit hjerte på vægten. Over for det ligger Ma'ats fjer. Har du nogen sidste ord?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis legt dein Herz auf die Waage. Ihr gegenüber liegt die Feder der Ma'at. Letzte Worte?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis pone tu corazón en la balanza. Enfrente, la pluma de Ma'at. ¿Alguna última palabra?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis asettaa sydämesi vaakaan. Sitä vastapäätä Ma'atin sulka. Onko sinulla viimeisiä sanoja?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis pose votre cœur sur la balance. En face, la plume de Ma'at. Des dernières paroles ?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Anúbis leggur hjarta þitt á vogina. Á móti henni liggur fjöður Ma'at. Einhver lokaorð?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubi posa il tuo cuore sulla bilancia. Di fronte, la piuma di Ma'at. Ultime parole?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アヌビスがあなたの心を天秤に載せます。向かいにはマアトの羽根。最後に言い残すことは？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아누비스가 당신의 심장을 저울에 올립니다. 맞은편에는 마아트의 깃털이 있어요. 마지막으로 남길 말이 있나요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis legger hjertet ditt på vekten. Overfor den ligger Ma'ats fjær. Noen siste ord?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis kładzie twoje serce na szali. Po drugiej stronie leży pióro Ma'at. Masz ostatnie słowa?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anúbis coloca o seu coração na balança. Do outro lado, a pena de Ma'at. Alguma última palavra?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis lägger ditt hjärta på vågen. Mitt emot ligger Ma'ats fjäder. Några sista ord?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阿努比斯把你的心放上天平，另一端是玛阿特之羽。还有遗言吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阿努比斯將你的心放上天平，另一端是瑪特之羽。還有遺言嗎？"
          }
        }
      }
    },
    "Anubis weighs your heart against the feather of Ma'at…": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis vejer dit hjerte mod Ma'ats fjer…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis legt dein Herz gegen die Feder der Ma'at…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis pesa tu corazón contra la pluma de Ma'at…"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis punnitsee sydämesi Ma'atin sulkaa vastaan…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis pèse votre cœur contre la plume de Ma'at…"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Anúbis vegur hjarta þitt á móti fjöður Ma'at…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubi pesa il tuo cuore contro la piuma di Ma'at…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アヌビスがあなたの心を、マアトの羽根と天秤にかけています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아누비스가 당신의 심장을 마아트의 깃털과 저울에 올려놓습니다…"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis veier hjertet ditt mot Ma'ats fjær…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis waży twoje serce z piórem Ma'at…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anúbis pesa o seu coração contra a pena de Ma'at…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anubis väger ditt hjärta mot Ma'ats fjäder…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阿努比斯将你的心与玛阿特之羽相比…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阿努比斯將你的心與瑪特之羽放在天平上……"
          }
        }
      }
    },
