        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Apple 계정에는 복원할 이전 구매 항목이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
