            "value": "あなたの魂はどこへ行くのか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 영혼은 어디로 갈까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor vil sjelen din gå?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokąd pójdzie twoja dusza?"
          }
        },
        "pt-BR": {
