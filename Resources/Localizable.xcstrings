    "The Chinvat Bridge widens beneath you. Your conscience, Daēnā, meets you as a radiant companion and leads you to the House of Song.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chinvat-broen udvider sig under dig. Din samvittighed, Daēnā, møder dig som en strålende ledsager og fører dig til Sangens hus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Chinvat-Brücke weitet sich unter dir. Dein Gewissen, Daēnā, begegnet dir als strahlende Gefährtin und führt dich zum Haus des Gesangs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puente Chinvat se ensancha bajo tus pies. Tu conciencia, Daēnā, te sale al encuentro como una compañera radiante y te lleva a la Casa del Canto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chinvatin silta levenee allasi. Omatuntosi, Daēnā, kohtaa sinut säteilevänä seuralaisena ja johdattaa sinut Laulun taloon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pont Chinvat s'élargit sous vous. Votre conscience, Daēnā, vous accueille sous la forme d'une compagne radieuse et vous conduit à la Maison du chant."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Chinvat-brúin breikkar undir þér. Samviska þín, Daēnā, mætir þér sem geislandi félagi og leiðir þig til Söngshússins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Ponte Chinvat si allarga sotto di te. La tua coscienza, Daēnā, ti incontra come una compagna radiosa e ti conduce alla casa del canto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チンヴァト橋があなたの足もとで広がります。あなたの良心であるダエナが、輝く連れとなって迎え、歌の館へ導きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친바트 다리가 발밑에서 넓어집니다. 당신의 양심, 다에나가 빛나는 동반자로 나타나 노래의 집으로 이끕니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Chinvat-broen vider seg ut under deg. Samvittigheten din, Daēnā, møter deg som en strålende følgesvenn og leder deg til Sangens hus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Most Czinwat rozszerza się pod tobą. Twoje sumienie, Daēnā, spotyka cię jako promienny towarzysz i prowadzi do Domu Pieśni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Ponte Chinvat se alarga sob você. Sua consciência, Daēnā, encontra você como uma companheira radiante e o leva à Casa do Canto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Chinvat-bron vidgas under dig. Ditt samvete, Daēnā, möter dig som en strålande följeslagare och leder dig till Sångens hus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钦瓦特桥在你脚下变宽。你的良知达埃纳以光辉的同伴身份与你相遇，并引你前往歌之屋。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "欽瓦脫橋在你腳下拓寬。你的良知達埃納以光輝的同伴身分前來迎接，帶你前往歌之屋。"
          }
        }
      }
    },
