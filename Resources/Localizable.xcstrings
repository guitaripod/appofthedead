    "The oracle's wisdom could not be reached at this time. Please try again later.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelets visdom kunne ikke nås i øjeblikket. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Weisheit des Orakels war gerade nicht erreichbar. Bitte versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sabiduría del Oráculo no estuvo al alcance en este momento. Inténtalo de nuevo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraakkelin viisauteen ei saatu yhteyttä juuri nyt. Yritä myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sagesse de l'Oracle est restée hors d'atteinte. Veuillez réessayer plus tard."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki er hægt að ná til visku Véfréttarinnar eins og er. Reyndu aftur síðar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La saggezza dell'Oracolo non è stata raggiungibile in questo momento. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オラクルの叡智に今は届きませんでした。しばらくしてからお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 오라클의 지혜에 닿지 못했습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelets visdom kunne ikke nås akkurat nå. Prøv igjen senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mądrość wyroczni była w tej chwili niedostępna. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sabedoria do Oráculo ficou fora de alcance neste momento. Tente novamente mais tarde."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraklets visdom kunde inte nås just nu. Försök igen senare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此刻未能触及神谕的智慧。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此刻未能觸及神諭的智慧。請稍後再試。"
          }
        }
      }
    },
    "The purchase could not be completed. Please try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købet kunne ikke gennemføres. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht abgeschlossen werden. Bitte versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la compra. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoa ei voitu viedä loppuun. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat n'a pas pu être finalisé. Veuillez réessayer."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að ganga frá kaupinu. Reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile completare l'acquisto. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を完了できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매를 완료할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet kunne ikke fullføres. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dokończyć zakupu. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a compra. Tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köpet kunde inte slutföras. Försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成购买。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成購買。請再試一次。"
          }
        }
      }
    },
    "The summoning was interrupted. Check your connection and try again — progress is kept.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldelsen blev afbrudt. Kontrollér din forbindelse, og prøv igen – dit fremskridt bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beschwörung wurde unterbrochen. Prüfe deine Verbindung und versuche es erneut – der Fortschritt bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La invocación se interrumpió. Comprueba tu conexión e inténtalo de nuevo: el progreso se conserva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutsuminen keskeytyi. Tarkista yhteys ja yritä uudelleen – edistyminen säilyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'invocation a été interrompue. Vérifiez votre connexion et réessayez — la progression est conservée."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Köllunin rofnaði. Athugaðu tenginguna og reyndu aftur – framvindan er geymd."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'evocazione è stata interrotta. Controlla la connessione e riprova: i progressi restano salvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "召喚が中断されました。接続を確認してもう一度お試しください。進捗は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소환이 중단되었습니다. 연결을 확인하고 다시 시도하세요. 진행 상황은 그대로 유지됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påkallelsen ble avbrutt. Kontroller tilkoblingen og prøv igjen, fremgangen din er bevart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywołanie zostało przerwane. Sprawdź połączenie i spróbuj ponownie — postęp jest zachowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A invocação foi interrompida. Verifique sua conexão e tente de novo — o progresso é mantido."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åkallandet avbröts. Kontrollera anslutningen och försök igen. Framstegen sparas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "召唤被中断。请检查网络连接后重试——进度会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "召喚被中斷。請檢查網路連線後再試一次——進度會保留。"
          }
        }
      }
    },
