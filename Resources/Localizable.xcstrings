          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ord å ta med deg"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słowa na drogę"
          }
        },
        "pt-BR": {
