    "Stay silent. Silence isn't lying.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tie stille. Tavshed er ikke at lyve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schweig. Schweigen ist keine Lüge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calla. El silencio no es mentir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaikene. Vaikeneminen ei ole valehtelemista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se taire. Le silence n'est pas un mensonge."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þegðu. Þögn er ekki lygi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Taci. Il silenzio non è menzogna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "沈黙する。沈黙は嘘ではない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "침묵한다. 침묵은 거짓말이 아니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold deg stille. Taushet er ikke løgn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj milczenie. Milczenie to nie kłamstwo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficar em silêncio. Silêncio não é mentir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Var tyst. Tystnad är inte att ljuga."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持沉默。沉默不等于撒谎。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持沉默。沉默不是說謊。"
          }
        }
      }
    },
