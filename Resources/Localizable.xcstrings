        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Apple 帳號沒有可回復的先前購買項目。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Apple-konto har ingen tidligere køb at gendanne."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä Apple-tilillä ei ole aiempia ostoja palautettavaksi."
          }
        },
        "is": {
