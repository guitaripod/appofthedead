    "We understand each other. I'm loyal too.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi forstår hinanden. Jeg er også loyal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir verstehen uns. Ich bin auch treu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos entendemos. Yo también soy leal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ymmärrämme toisemme. Minäkin olen uskollinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous nous comprenons. Je suis fidèle, moi aussi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Við skiljum hvort annað. Ég stend líka við mitt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci capiamo. Anch'io sono leale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "わかり合えるもの同士。私も忠実です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우리는 서로를 이해해요. 나도 충실해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi forstår hverandre. Jeg er lojal også."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozumiemy się. Lojalność to także moja cecha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nós nos entendemos. Também sou leal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi förstår varandra. Jag är också lojal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们彼此懂得。我也一样忠诚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們彼此懂得。我也一樣忠誠。"
          }
        }
      }
    },
    "Weigh it. I'm not afraid.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vej den. Jeg er ikke bange."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiege es. Ich habe keine Angst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pésalo. No tengo miedo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Punnitse. En pelkää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesez-la. Je n'ai pas peur."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegðu það. Ég óttast ekki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesalo. Non ho paura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "量ってください。恐れてはいません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달아 보세요. 두렵지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vei den. Jeg er ikke redd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waż. Nie boję się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pese. Não tenho medo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väg den. Jag är inte rädd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "称吧。我不害怕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "秤吧。我不害怕。"
          }
        }
      }
    },
