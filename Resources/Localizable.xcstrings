    "Bend it a little. Everyone does.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøj den lidt. Det gør alle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Biege es ein wenig. Das tut jeder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dóblala un poco. Todos lo hacen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taivuta sitä vähän. Kaikki tekevät niin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plier un peu. Tout le monde le fait."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Beygðu það aðeins. Allir gera það."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piegala un po'. Lo fanno tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少しだけ曲げる。誰でもそうする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조금 구부린다. 다들 그러니까."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøy den litt. Alle gjør det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagnij trochę. Wszyscy tak robią."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobrar um pouco. Todo mundo faz isso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Böj det lite. Alla gör det."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微变通一下。人人都会这样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微變通一下。人人都會。"
          }
        }
      }
    },
