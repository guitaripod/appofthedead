          }
        }
      }
    },
    "Your Soul Card": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit sjælskort"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Seelenkarte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tarjeta del alma"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sielukorttisi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre carte d'âme"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sálarkortið þitt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua Carta dell'anima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのソウルカード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 영혼 카드"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt sjelkort"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja karta duszy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Cartão da Alma"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt själskort"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的灵魂卡"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的靈魂卡"
          }
        }
      }
    },
    "Your good and evil weigh exactly the same. You wait in Hamistagan, a grey middle place, until the world is made new.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit gode og dit onde vejer præcis lige meget. Du venter i Hamistagan, et gråt mellemrum, indtil verden bliver fornyet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gutes und dein Böses wiegen genau gleich viel. Du wartest in Hamistagan, einem grauen Zwischenort, bis die Welt erneuert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu bien y tu mal pesan exactamente lo mismo. Esperas en Hamistagan, un lugar gris intermedio, hasta que el mundo sea renovado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyvääsi ja pahaasi painavat täsmälleen yhtä paljon. Odotat Hamistaganissa, harmaassa välipaikassa, kunnes maailma uudistuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bien et le mal pèsent exactement le même poids en vous. Vous attendez à Hamistagan, un entre-deux gris, jusqu'à ce que le monde soit renouvelé."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það góða og illa í þér vega nákvæmlega jafnt. Þú bíður í Hamistagan, gráum millistað, þar til heimurinn verður endurnýjaður."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bene e il male che hai fatto pesano esattamente uguale. Attendi a Hamistagan, un luogo grigio di mezzo, finché il mondo non sarà rinnovato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "善と悪の重さが、ちょうど同じでした。あなたは灰色の中間の地ハミスタガーンで、世界が新たにされる時を待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 선과 악은 정확히 같은 무게입니다. 세상이 새로 만들어질 때까지, 잿빛 중간 지대 하미스타간에서 기다리게 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gode og det onde veier akkurat like mye. Du venter i Hamistagan, et grått mellomsted, til verden blir fornyet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobro i zło ważą dokładnie tyle samo. Czekasz w Hamistagan, szarym miejscu pośrodku, aż świat zostanie odnowiony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu bem e seu mal pesam exatamente o mesmo. Você espera em Hamistagan, um lugar cinzento intermediário, até que o mundo seja renovado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt goda och onda väger exakt lika mycket. Du väntar i Hamistagan, en grå mellanplats, tills världen förnyas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的善与恶分量完全相等。你在哈米斯塔甘等待，那是一个灰色的中间之地，直到世界重获新生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的善與惡分量完全相同。你在哈米斯塔岡等待，那是一處灰色的中間之地，直到世界重新被創造。"
          }
        }
      }
    },
    "Your heart balances the feather of Ma'at. Osiris welcomes you to Aaru, an Egypt without end where the barley grows taller than a man.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit hjerte balancerer Ma'ats fjer. Osiris byder dig velkommen til Aaru, et Egypten uden ende, hvor bygget vokser højere end et menneske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Herz hält der Feder der Ma'at die Waage. Osiris heißt dich im Aaru willkommen, einem Ägypten ohne Ende, wo die Gerste höher wächst als ein Mensch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu corazón equilibra la pluma de Ma'at. Osiris te da la bienvenida a Aaru, un Egipto sin fin donde la cebada crece más alta que un hombre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sydämesi tasapainottaa Ma'atin sulan. Osiris toivottaa sinut tervetulleeksi Aaruun, loputtomaan Egyptiin, jossa ohra kasvaa miestä pidemmäksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre cœur équilibre la plume de Ma'at. Osiris vous accueille à Aaru, une Égypte sans fin où l'orge pousse plus haut qu'un homme."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjarta þitt jafnar fjöður Ma'at. Osiris tekur á móti þér í Aaru, Egyptalandi án enda, þar sem byggið vex hærra en maðurinn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo cuore bilancia la piuma di Ma'at. Osiride ti accoglie ad Aaru, un Egitto senza fine dove l'orzo cresce più alto di un uomo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの心はマアトの羽根と釣り合いました。オシリスが、終わりのないエジプト、大麦が人の背より高く育つアアルへ迎えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 심장은 마아트의 깃털과 균형을 이룹니다. 오시리스가 아루로 당신을 맞이합니다. 끝없는 이집트, 보리가 사람보다 높이 자라는 곳입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjertet ditt holder Ma'ats fjær i balanse. Osiris ønsker deg velkommen til Aaru, et Egypt uten ende der bygget vokser høyere enn et menneske."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje serce równoważy pióro Ma'at. Ozyrys wita cię w Aaru, Egipcie bez końca, gdzie jęczmień rośnie wyżej niż człowiek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu coração equilibra a pena de Ma'at. Osíris dá as boas-vindas a Aaru, um Egito sem fim onde a cevada cresce mais alta que um homem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt hjärta väger lika mycket som Ma'ats fjäder. Osiris välkomnar dig till Aaru, ett Egypten utan slut där kornet växer högre än en människa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心与玛阿特之羽持平。奥西里斯迎你进入阿鲁，那是一片无尽的埃及，大麦高过人身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心與瑪特之羽取得平衡。歐西里斯歡迎你來到阿魯，那是一片無盡的埃及，大麥高過人身。"
          }
        }
      }
    },
    "Your heart is lighter than the feather. You join Ra in his solar barque, sailing the sky by day and the underworld by night.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit hjerte er lettere end fjeren. Du slutter dig til Ra i hans solbarke, der sejler over himlen om dagen og gennem underverdenen om natten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Herz ist leichter als die Feder. Du begleitest Ra in seiner Sonnenbarke, die tagsüber den Himmel und nachts die Unterwelt befährt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu corazón pesa menos que la pluma. Te unes a Ra en su barca solar, que surca el cielo de día y el inframundo de noche."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sydämesi on sulkaa kevyempi. Liityt Ra:n seuraan hänen aurinkoveneessään, purjehtien taivaalla päivisin ja alamaailmassa öisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre cœur est plus léger que la plume. Vous rejoignez Ra sur sa barque solaire, qui navigue dans le ciel le jour et dans le monde souterrain la nuit."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjarta þitt er léttara en fjöðrin. Þú gengur til liðs við Ra á sólarbarkinu hans, sem siglir um himininn á daginn og undirheimana á nóttunni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo cuore è più leggero della piuma. Ti unisci a Ra sulla sua barca solare, a navigare il cielo di giorno e il mondo sotterraneo di notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの心は羽根より軽い。ラーの太陽の舟に加わり、昼は空を、夜は冥界を渡ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 심장은 깃털보다 가볍습니다. 낮에는 하늘을, 밤에는 저승을 가르는 라의 태양선에 올라 그와 함께 항해합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjertet ditt er lettere enn fjæren. Du blir med Ra i solbåten hans, som seiler over himmelen om dagen og gjennom underverdenen om natten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje serce jest lżejsze od pióra. Dołączasz do Ra w jego słonecznej łodzi, żeglując po niebie za dnia i po zaświatach w nocy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu coração é mais leve que a pena. Você se junta a Rá em sua barca solar, navegando o céu de dia e o submundo de noite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt hjärta är lättare än fjädern. Du följer med Ra i hans solbark och seglar över himlen på dagen och genom underjorden på natten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心比羽毛还轻。你随拉神登上日船，白天航行于天空，夜晚航行于冥界。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心比羽毛還輕。你與拉同乘太陽船，白天航行天空，夜晚穿越冥界。"
          }
        }
      }
    },
    "Your heart is weighed against the feather of Ma'at": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit hjerte vejes mod Ma'ats fjer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Herz wird gegen die Feder der Ma'at gewogen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu corazón se pesa contra la pluma de Ma'at"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sydäntäsi punnitaan Ma'atin sulkaa vastaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre cœur est pesé contre la plume de Ma'at"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjarta þitt er vegið á móti fjöður Ma'at"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo cuore viene pesato contro la piuma di Ma'at"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの心をマアトの羽根と天秤にかけています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 심장을 마아트의 깃털과 저울에 답니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjertet ditt veies mot Ma'ats fjær"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje serce jest ważone z piórem Ma'at"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu coração é pesado contra a pena de Ma'at"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt hjärta vägs mot Ma'ats fjäder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心正在与玛阿特之羽称量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心正與瑪特之羽相秤"
          }
        }
      }
    },
    "Your heart outweighs the feather, and Ammit, part crocodile, part lion, part hippo, devours it. Egyptians were buried with a heart scarab so their heart would not testify against them. Consider one.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit hjerte vejer tungere end fjeren, og Ammit, halvt krokodille, halvt løve, halvt flodhest, sluger det. Egypterne blev begravet med en hjerteskarabæ, så deres hjerte ikke kunne vidne imod dem. Overvej en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Herz wiegt schwerer als die Feder, und Ammit, halb Krokodil, halb Löwe, halb Nilpferd, verschlingt es. Ägypter wurden mit einem Herzskarabäus bestattet, damit ihr Herz nicht gegen sie aussagt. Schau dir einen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu corazón pesa más que la pluma, y Ammit, mitad cocodrilo, mitad león, mitad hipopótamo, lo devora. Los egipcios se enterraban con un escarabeo de corazón para que su corazón no testificara en su contra. Considera uno."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sydämesi painaa sulkaa enemmän, ja Ammit, osittain krokotiili, osittain leijona ja osittain virtahepo, syö sen. Egyptiläiset haudattiin sydänskarabeus mukanaan, jotta heidän sydämensä ei todistaisi heitä vastaan. Katso yhtä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre cœur est plus lourd que la plume, et Ammit, mi-crocodile, mi-lion, mi-hippopotame, le dévore. Les Égyptiens étaient enterrés avec un scarabée du cœur pour que leur cœur ne témoigne pas contre eux. Pensez-y."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjarta þitt vegur þyngra en fjöðrin, og Ammit, hálf krókódíll, hálf ljón, hálf flóðhestur, gleypir það. Egyptar voru grafnir með hjartaskarabeus svo hjarta þeirra bæri ekki vitni gegn þeim. Skoðaðu einn slíkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo cuore pesa più della piuma, e Ammit, metà coccodrillo, metà leone, metà ippopotamo, lo divora. Gli egizi venivano sepolti con uno scarabeo del cuore, perché il loro cuore non testimoniasse contro di loro. Considerane uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの心は羽根より重く、ワニと獅子とカバが混ざった姿のアメミットがそれを喰らいます。エジプトの人々は、心が自分に不利な証言をしないよう、心臓のスカラベと共に埋葬されました。一つ手に取ってみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 심장이 깃털보다 무거워, 악어와 사자와 하마가 뒤섞인 암미트가 그것을 삼켜 버립니다. 이집트인들은 심장이 자신을 고발하지 못하도록 심장 풍뎅이 부적과 함께 묻혔습니다. 하나 떠올려 보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjertet ditt er tyngre enn fjæren, og Ammit, halvt krokodille, halvt løve, halvt nilhest, sluker det. Egyptere ble gravlagt med en hjerteskarabé, slik at hjertet deres ikke skulle vitne mot dem. Ta en titt på en."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje serce waży więcej niż pióro, a Ammit, po części krokodyl, po części lew, po części hipopotam, je pożera. W Egipcie zmarłym kładziono na sercu skarabeusza, by serce nie zeznawało przeciwko nim. Spójrz na jednego z nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu coração pesa mais que a pena, e Ammit, meio crocodilo, meio leão, meio hipopótamo, o devora. Os egípcios eram enterrados com um escaravelho do coração para que o coração não testemunhasse contra eles. Considere um."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt hjärta väger tyngre än fjädern, och Ammit, till hälften krokodil, till hälften lejon och till hälften flodhäst, slukar det. Egyptier begravdes med en hjärtskarabé så att deras hjärta inte skulle vittna mot dem. Ta en titt på en."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心比羽毛重，阿米特（半鳄鱼、半狮子、半河马）将它吞噬。古埃及人下葬时会佩戴心脏圣甲虫，好让心脏不为他们作证。不妨看看一枚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心比羽毛重，阿米特（半鱷、半獅、半河馬的怪獸）將它吞噬。埃及人下葬時會放一枚心臟聖甲蟲，免得心臟替他們作證。不妨想想那枚聖甲蟲。"
          }
        }
      }
    },
    "Your merit ripens into rebirth among the devas, a bliss so long you forget that it ends.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din fortjeneste modnes til genfødsel blandt deverne, en salighed så lang, at du glemmer, at den ender."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Verdienst reift zur Wiedergeburt unter den Devas, einer Seligkeit so lang, dass du vergisst, dass sie endet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mérito madura en un renacimiento entre los devas, una dicha tan larga que olvidas que tiene fin."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansiosi kypsyy jälleensyntymäksi devojen joukossa, autuudessa, joka kestää niin kauan, että unohdat sen loppuvan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mérite mûrit en renaissance parmi les devas, une béatitude si longue que vous oubliez qu'elle finit."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Verðleiki þinn þroskast í endurfæðingu í hópi devanna, sælu svo langri að þú gleymir að hún lýkur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo merito matura in rinascita tra i deva, una beatitudine così lunga che dimentichi che finisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの功徳は熟して、天の神々のもとへの再生となります。その至福はあまりに長く、終わりがあることさえ忘れてしまうほどです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 공덕은 데바들 사이에서 환생으로 익어 갑니다. 그 행복은 너무 길어서 끝이 있다는 것조차 잊게 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din fortjeneste modnes til gjenfødelse blant devaene, en salighet så lang at du glemmer at den tar slutt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja zasługa dojrzewa w odrodzenie wśród dewów, w błogostan tak długi, że zapominasz, iż się kończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu mérito amadurece em renascimento entre os devas, uma bem-aventurança tão longa que você esquece que ela termina."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din förtjänst mognar till återfödelse bland devorna, en salighet så lång att du glömmer att den tar slut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的功德成熟，转生于天神之中，那福乐如此绵长，以至于你忘了它终会结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的功德成熟，轉生於天神之中，那份喜樂如此漫長，以至於你忘了它終有盡頭。"
          }
        }
      }
    },
