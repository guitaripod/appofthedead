    "Try the first lesson free. Unlock the full path whenever you're ready.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv den første lektion gratis. Lås hele vejen op, når du er klar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere die erste Lektion gratis. Schalte den ganzen Pfad frei, wann immer du willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba gratis la primera lección. Desbloquea el camino entero cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile ensimmäistä oppituntia ilmaiseksi. Avaa koko polku, kun olet valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez la première leçon gratuitement. Débloquez la voie entière quand vous le souhaitez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Prófaðu fyrstu kennslustundina ókeypis. Opnaðu alla leiðina hvenær sem þú vilt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova gratis la prima lezione. Sblocca l'intero percorso quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のレッスンは無料でお試しいただけます。道の全体はいつでも解放できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 레슨은 무료로 체험하세요. 전체 길은 원할 때 잠금 해제하면 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv den første leksjonen gratis. Lås opp hele veien når du er klar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypróbuj pierwszą lekcję za darmo. Odblokuj całą ścieżkę, kiedy zechcesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente a primeira lição de graça. Libere o caminho inteiro quando quiser."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova första lektionen gratis. Lås upp hela vägen när du vill."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费试听第一节课。想解锁整条路径时随时都可以。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費試上第一節課。想解鎖整條路徑時隨時都可以。"
          }
        }
      }
    },
    "Turn on notifications for App of the Dead in Settings to get daily reminders.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå notifikationer til for App of the Dead i Indstillinger for at få daglige påmindelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Mitteilungen für App of the Dead in den Einstellungen, um tägliche Erinnerungen zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones de App of the Dead en Ajustes para recibir recordatorios diarios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota App of the Deadin ilmoitukset käyttöön Asetuksissa, niin saat päivittäiset muistutukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les notifications d'App of the Dead dans Réglages pour recevoir les rappels quotidiens."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kveiktu á tilkynningum fyrir App of the Dead í Stillingum til að fá daglegar áminningar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le notifiche di App of the Dead in Impostazioni per ricevere i promemoria giornalieri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日のリマインダーを受け取るには、設定で App of the Dead の通知を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 알림을 받으려면 설정에서 App of the Dead의 알림을 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på varsler for App of the Dead i Innstillinger for å få daglige påminnelser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz powiadomienia dla App of the Dead w Ustawieniach, aby otrzymywać codzienne przypomnienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as notificações do App of the Dead nos Ajustes para receber lembretes diários."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på notiser för App of the Dead i Inställningar för att få dagliga påminnelser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「设置」中开启 App of the Dead 的通知，以接收每日提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中開啟 App of the Dead 的通知，以接收每日提醒。"
          }
        }
      }
    },
