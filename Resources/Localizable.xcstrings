    "Unable to download the Oracle model. Please check your internet connection and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelmodellen kunne ikke hentes. Kontrollér din internetforbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Orakel-Modell konnte nicht geladen werden. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar el modelo del Oráculo. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraakkelimallia ei voitu ladata. Tarkista internetyhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de télécharger le modèle de l'Oracle. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að sækja Véfréttarlíkanið. Athugaðu nettenginguna og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare il modello dell'Oracolo. Controlla la connessione a internet e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オラクルのモデルをダウンロードできませんでした。インターネット接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오라클 모델을 다운로드할 수 없습니다. 인터넷 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke laste ned Orakelmodellen. Kontroller internettilkoblingen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się pobrać modelu Wyroczni. Sprawdź połączenie internetowe i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível baixar o modelo do Oráculo. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det går inte att hämta orakelmodellen. Kontrollera din internetanslutning och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法下载神谕模型。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法下載神諭模型。請檢查網路連線後再試一次。"
          }
        }
      }
    },
    "Unable to establish divine connection. Please try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kunne ikke oprettes forbindelse til det guddommelige. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die göttliche Verbindung kam nicht zustande. Bitte versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo establecer la conexión divina. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
