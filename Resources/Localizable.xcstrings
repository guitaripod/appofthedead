    "The Judgment's ruling on your soul: %@. %@ and every other path are one step away.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dommens afgørelse om din sjæl: %1$@. %2$@ og alle andre veje er ét skridt væk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Urteil des Totengerichts über deine Seele: %1$@. %2$@ und alle anderen Pfade sind nur einen Schritt entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El veredicto del Juicio sobre tu alma: %1$@. %2$@ y todos los demás caminos están a un paso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuomion ratkaisu sielustasi: %1$@. %2$@ ja kaikki muut polut ovat yhden askeleen päässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le verdict du Jugement sur votre âme : %1$@. %2$@ et tous les autres parcours ne sont plus qu'à un pas."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Úrskurður Dómsins um sál þína: %1$@. %2$@ og allar aðrar leiðir eru einu skrefi í burtu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il verdetto del Giudizio sulla tua anima: %1$@. %2$@ e tutti gli altri percorsi sono a un passo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "審判があなたの魂に下した裁定：%1$@。%2$@ や他のすべての道も、あと一歩です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심판이 당신의 영혼에 내린 판결: %1$@. %2$@ 및 다른 모든 길도 한 걸음 거리에 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dommens avgjørelse om sjelen din: %1$@. %2$@ og alle andre veier er ett steg unna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyrok Sądu nad twoją duszą: %1$@. %2$@ i każda inna ścieżka są o krok stąd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O veredito do Julgamento sobre a sua alma: %1$@. %2$@ e todos os outros caminhos estão a um passo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Domens utslag om din själ: %1$@. %2$@ och alla andra vägar är ett steg bort."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审判对你灵魂的裁决：%1$@。%2$@ 和其他所有路径只需一步即可抵达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審判對你靈魂的裁決：%1$@。%2$@ 和其他所有路徑只要一步就能到達。"
          }
