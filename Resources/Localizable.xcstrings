    "Or unlock just %@ for %@": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eller lås kun %@ op for %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder nur %1$@ für %2$@ freischalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O desbloquea solo %1$@ por %2$@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai avaa vain %@ hintaan %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou débloquez seulement %1$@ pour %2$@"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eða opnaðu aðeins %@ fyrir %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure sblocca solo %1$@ per %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "または %2$@ で %1$@ のみを解放"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 %2$@에 %1$@만 잠금 해제"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eller lås opp bare %@ for %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lub odblokuj tylko %1$@ za %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou desbloqueie só %1$@ por %2$@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Eller lås upp bara %@ för %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或仅以 %2$@ 解锁 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "或僅以 %2$@ 解鎖 %1$@"
          }
        }
      }
    },
    "%@ is silent on this. Ask it another way.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er tavs om dette. Spørg på en anden måde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ schweigt dazu. Frag auf eine andere Weise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ guarda silencio sobre esto. Pregúntale de otra forma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei vastaa tähän. Kysy toisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reste silencieux sur ce point. Demandez autrement."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ þegir um þetta. Spyrðu á annan hátt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tace su questo. Chiedi in un altro modo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこれについて沈黙しています。別の聞き方で尋ねてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 질문에 대해서는 %@의 답이 없어요. 다르게 물어보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sier ingenting om dette. Spør på en annen måte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ milczy w tej sprawie. Zapytaj inaczej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não responde a isso. Pergunte de outro jeito."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiger om detta. Fråga på ett annat sätt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 对此保持沉默。换个方式再问一次吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 對此保持沉默。換個方式再問一次。"
          }
        }
      }
    },
