        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verità che ho detto quando mentire era più facile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "嘘をつく方が楽だったのに語った真実"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거짓말이 더 쉬웠을 때도 한 진실들"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sannheter jeg fortalte da det var lettere å lyve"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawdy powiedziane, mimo że kłamstwo było łatwiejsze"
