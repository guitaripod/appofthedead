        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将前往之处"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你將前往之處"
          }
        }
      }
    },
    "Words to carry with you": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Worte zum Mitnehmen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Palabras para llevarte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mots à garder en mémoire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parole da portare con te"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "持ち帰る言葉"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간직할 단어들"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słowa na drogę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Palavras para levar consigo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带在身上的词语"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帶在身上的詞語"
          }
        }
      }
    },
    "Yama": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヤマ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "야마"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jama"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阎摩"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閻摩"
          }
        }
      }
    },
    "Yama holds up the mirror of karma. It shows what you cling to most.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama hält dir den Spiegel des Karma vor. Er zeigt, woran du am meisten hängst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama sostiene el espejo del karma. Muestra a qué te aferras más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama tend le miroir du karma. Il montre à quoi vous tenez le plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama alza lo specchio del karma. Mostra ciò a cui ti aggrappi di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヤマがカルマの鏡を掲げます。そこに映るのは、あなたが最も執着しているものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "야마가 업의 거울을 들어 올립니다. 당신이 가장 집착하는 것을 비춰 보입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jama podnosi lustro karmy. Pokazuje to, czego najbardziej się trzymasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama ergue o espelho do carma. Ele mostra aquilo a que você mais se apega."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阎摩举起业镜。它映照出你最执着的东西。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閻摩舉起業鏡，映出你最執著的事物。"
          }
        }
      }
    },
    "You are reborn human: the rarest birth, and the only one from which awakening is possible.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst als Mensch wiedergeboren: die seltenste Geburt, und die einzige, aus der Erwachen möglich ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renaces como humano: el nacimiento más raro, y el único desde el que el despertar es posible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous renaissez humain : la naissance la plus rare, et la seule à partir de laquelle l'éveil est possible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinasci umano: la nascita più rara, e l'unica dalla quale il risveglio è possibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは人間として生まれ変わります。最も稀な生であり、目覚めへ至ることのできる唯一の生です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 인간으로 다시 태어납니다. 가장 드문 태어남이며, 깨달음이 가능한 유일한 태어남입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odradzasz się jako człowiek: to najrzadsze narodziny, jedyne, z których przebudzenie jest możliwe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você renasce humano: o nascimento mais raro, e o único a partir do qual o despertar é possível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你转生为人：这是最罕见的出生，也是唯一能够觉悟的一世。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你轉生為人：這是最稀有的誕生，也是唯一可以覺醒的一種。"
          }
        }
      }
    },
    "You cling to almost nothing. The wheel of rebirth can barely hold you, and awakening is close.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hältst kaum an etwas fest. Das Rad der Wiedergeburt kann dich kaum halten, und das Erwachen ist nah."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi no te aferras a nada. La rueda del renacimiento apenas puede retenerte, y el despertar está cerca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne vous accrochez presque à rien. La roue de la renaissance peine à vous retenir, et l'éveil est proche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ti aggrappi quasi a nulla. La ruota della rinascita fatica a trattenerti, e il risveglio è vicino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたはほとんど何にも執着していません。輪廻の車輪もあなたを捉えきれず、目覚めは近いのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 거의 아무것에도 매달리지 않습니다. 윤회의 바퀴는 당신을 거의 붙잡지 못하고, 깨달음이 가까이 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niczego się prawie nie trzymasz. Koło odrodzeń ledwie cię utrzymuje, a przebudzenie jest blisko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você quase não se apega a nada. A roda do renascimento mal consegue segurar você, e o despertar está próximo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你几乎什么都不执着。轮回之轮几乎无法留住你，觉悟已近在咫尺。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你幾乎不執著任何事物。輪迴之輪幾乎難以留住你，覺醒已近在咫尺。"
          }
        }
      }
    },
    "You hold on to almost nothing, and that is what makes you free. The wheel of rebirth can barely grip you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hältst an fast nichts fest, und genau das macht dich frei. Das Rad der Wiedergeburt kann dich kaum packen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te aferras a casi nada, y eso es lo que te hace libre. La rueda del renacimiento apenas puede sujetarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne retenez presque rien, et c'est ce qui vous rend libre. La roue de la renaissance a du mal à vous saisir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non trattieni quasi nulla, ed è questo che ti rende libero. La ruota della rinascita fatica a stringerti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんど何にも執着せず、それゆえ自由です。輪廻の車輪はあなたをほとんど掴めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 거의 아무것도 붙잡지 않고, 그래서 자유로워요. 윤회의 바퀴도 당신을 제대로 붙잡지 못해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawie niczego się nie trzymasz i właśnie to czyni cię wolnym. Koło odrodzeń ledwie cię chwyta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não se apega a quase nada, e é isso que o torna livre. A roda do renascimento mal consegue prender você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你几乎什么都不执着，正因如此你才自由。轮回之轮几乎无法抓住你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你幾乎不緊抓任何事物，正因如此你才自由。輪迴之輪幾乎難以捉住你。"
          }
        }
      }
    },
    "You would give your last coin to a stranger on the shore. Every underworld needs someone carrying a light.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du würdest deine letzte Münze einem Fremden am Ufer geben. Jede Unterwelt braucht jemanden, der ein Licht trägt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Darías tu última moneda a un desconocido en la orilla. Todo inframundo necesita a alguien que lleve una luz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous donneriez votre dernière pièce à un inconnu sur la rive. Tout monde souterrain a besoin de quelqu'un qui porte une lumière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Daresti la tua ultima moneta a uno sconosciuto sulla riva. Ogni mondo sotterraneo ha bisogno di qualcuno che porti una luce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "岸辺の見知らぬ人に最後の一枚を差し出すでしょう。どんな冥界にも、明かりを運ぶ者が必要なのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 강가의 낯선 이에게 마지막 동전이라도 건넬 사람이에요. 모든 저승에는 빛을 들고 가는 누군가가 필요하니까요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnią monetę oddasz obcemu na brzegu. Każdy świat podziemny potrzebuje kogoś, kto niesie światło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você daria sua última moeda a um desconhecido na margem. Todo submundo precisa de alguém que carregue uma luz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会把最后一枚硬币给岸边的陌生人。每个冥界都需要有人提灯照路。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你會把最後一枚硬幣給岸邊的陌生人。每個冥界都需要有人提燈前行。"
          }
        }
      }
    },
    "You would haggle with the ferryman and ask to speak to his manager. Hermes, patron of tricksters, approves.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du würdest mit dem Fährmann feilschen und seinen Chef sprechen wollen. Hermes, Schutzpatron der Schelme, billigt das."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regatearías con el barquero y pedirías hablar con su jefe. Hermes, patrón de los embaucadores, lo aprueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous marchanderiez avec le passeur et demanderiez à parler à son responsable. Hermès, patron des farceurs, approuve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrateresti con il traghettatore e chiederesti di parlare con il suo responsabile. Ermes, patrono dei burloni, approva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "渡し守と値切り交渉をし、責任者を出せと言うでしょう。詐術の守護神ヘルメスも、きっと喜びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 뱃사공과 값을 흥정하고 책임자와 이야기하자고 할 사람이에요. 속임수꾼들의 수호신 헤르메스도 좋아할 거예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Targujesz się z przewoźnikiem i żądasz rozmowy z jego przełożonym. Hermes, patron oszustów, to aprobuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você negociaria com o barqueiro e pediria para falar com o gerente dele. Hermes, patrono dos trapaceiros, aprova."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会和船夫讨价还价，还要求见他的经理。狡黠者的守护神赫尔墨斯会赞许你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你會與擺渡人討價還價，還要求見他的主管。詭計之神赫爾墨斯會讚許你。"
          }
        }
      }
    },
    "You would rather pay for the truth than live on a lie. Hearts like yours are why the feather of Ma'at exists.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du zahlst lieber für die Wahrheit, als mit einer Lüge zu leben. Herzen wie deines sind der Grund, warum es die Feder der Ma'at gibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferirías pagar por la verdad antes que vivir de una mentira. Corazones como el tuyo son la razón de que exista la pluma de Ma'at."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous préféreriez payer pour la vérité plutôt que vivre d'un mensonge. Des cœurs comme le vôtre sont la raison d'être de la plume de Ma'at."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferiresti pagare per la verità piuttosto che vivere di menzogna. Cuori come il tuo sono il motivo per cui esiste la piuma di Ma'at."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "嘘の上に生きるくらいなら、真実に代価を払う方を選ぶ人です。あなたのような心があるからこそ、マアトの羽根が存在するのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 거짓으로 사느니 진실에 값을 치르겠다고 하겠지요. 당신 같은 심장 때문에 마아트의 깃털이 있는 거예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wolisz zapłacić za prawdę, niż żyć kłamstwem. Serca takie jak twoje są powodem, dla którego istnieje pióro Ma'at."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você preferiria pagar pela verdade a viver de uma mentira. Corações como o seu são a razão de a pena de Ma'at existir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你宁愿为真相付出代价，也不愿靠谎言生活。像你这样的心，正是玛阿特之羽存在的缘由。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你寧願付出代價換取真相，也不願活在謊言裡。像你這樣的心，正是瑪特之羽存在的理由。"
          }
        }
      }
    },
    "You would swim the Styx before paying the toll. The halls of the brave keep a seat for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du würdest den Styx lieber durchschwimmen, als den Zoll zu zahlen. In den Hallen der Tapferen ist ein Platz für dich frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadarías el Estigia antes que pagar el peaje. Los salones de los valientes te guardan un asiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous traverseriez le Styx à la nage plutôt que de payer le péage. Les salles des braves gardent une place pour vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuoteresti lo Stige piuttosto che pagare il pedaggio. Le sale dei coraggiosi tengono un posto per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "渡し賃を払うくらいなら、ステュクスを泳いで渡る人です。勇者の館には、あなたのための席があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 통행료를 내느니 스틱스를 헤엄쳐 건너겠지요. 용사들의 전당에는 당신을 위한 자리가 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wolisz przepłynąć Styks, niż zapłacić myto. Sale dzielnych mają dla ciebie miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você nadaria o Estige antes de pagar o pedágio. Os salões dos bravos guardam um lugar para você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你宁愿游过冥河也不愿付过路费。勇者的殿堂为你留着一个座位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你寧可游過冥河，也不願付過路費。勇士的殿堂為你保留了座位。"
          }
        }
      }
    },
    "You would take the road no one comes back from, just to see. The Mysteries were made for souls like yours.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du würdest den Weg, von dem niemand zurückkehrt, nur aus Neugier gehen. Die Mysterien sind für Seelen wie deine gemacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomarías el camino del que nadie regresa, solo por ver. Los Misterios se hicieron para almas como la tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous prendriez la route dont nul ne revient, rien que pour voir. Les Mystères ont été faits pour des âmes comme la vôtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenderesti la strada da cui nessuno torna, solo per vedere. I Misteri sono fatti per anime come la tua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ただ見届けるために、誰も戻らない道を行くでしょう。秘儀は、あなたのような魂のために設けられたのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 아무도 돌아오지 않는 길이라도 직접 보려고 들어설 사람이에요. 신비의식은 당신 같은 영혼을 위해 있는 거예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pójdziesz drogą, z której nikt nie wraca, choćby po to, by zobaczyć. Misteria stworzono dla dusz takich jak twoja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você seguiria a estrada de onde ninguém volta, só para ver. Os Mistérios foram feitos para almas como a sua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你愿意走上无人归返的路，只为一探究竟。秘仪正是为你这样的灵魂而设。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你會走上無人歸返的道路，只為親眼看看。奧秘正是為像你這樣的靈魂而設。"
          }
        }
      }
    },
    "Your Premium Week Has Ended": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Premium-Woche ist vorbei"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu semana Premium ha terminado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre semaine Premium est terminée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua settimana Premium è finita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレミアム週間が終了しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리미엄 주간이 끝났어요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój tydzień Premium dobiegł końca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua semana Premium terminou"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的高级周已结束"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的進階週已結束"
          }
        }
      }
    },
    "Your Soul Card": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Seelenkarte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tarjeta del alma"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre carte d'âme"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua Carta dell'anima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのソウルカード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 영혼 카드"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja karta duszy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Cartão da Alma"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的灵魂卡"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的靈魂卡"
          }
        }
      }
    },
    "Your good and evil weigh exactly the same. You wait in Hamistagan, a grey middle place, until the world is made new.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gutes und dein Böses wiegen genau gleich viel. Du wartest in Hamistagan, einem grauen Zwischenort, bis die Welt erneuert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu bien y tu mal pesan exactamente lo mismo. Esperas en Hamistagan, un lugar gris intermedio, hasta que el mundo sea renovado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bien et le mal pèsent exactement le même poids en vous. Vous attendez à Hamistagan, un entre-deux gris, jusqu'à ce que le monde soit renouvelé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bene e il male che hai fatto pesano esattamente uguale. Attendi a Hamistagan, un luogo grigio di mezzo, finché il mondo non sarà rinnovato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "善と悪の重さが、ちょうど同じでした。あなたは灰色の中間の地ハミスタガーンで、世界が新たにされる時を待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 선과 악은 정확히 같은 무게입니다. 세상이 새로 만들어질 때까지, 잿빛 중간 지대 하미스타간에서 기다리게 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobro i zło ważą dokładnie tyle samo. Czekasz w Hamistagan, szarym miejscu pośrodku, aż świat zostanie odnowiony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu bem e seu mal pesam exatamente o mesmo. Você espera em Hamistagan, um lugar cinzento intermediário, até que o mundo seja renovado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的善与恶分量完全相等。你在哈米斯塔甘等待，那是一个灰色的中间之地，直到世界重获新生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的善與惡分量完全相同。你在哈米斯塔岡等待，那是一處灰色的中間之地，直到世界重新被創造。"
          }
        }
      }
    },
    "Your heart balances the feather of Ma'at. Osiris welcomes you to Aaru, an Egypt without end where the barley grows taller than a man.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Herz hält der Feder der Ma'at die Waage. Osiris heißt dich im Aaru willkommen, einem Ägypten ohne Ende, wo die Gerste höher wächst als ein Mensch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu corazón equilibra la pluma de Ma'at. Osiris te da la bienvenida a Aaru, un Egipto sin fin donde la cebada crece más alta que un hombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre cœur équilibre la plume de Ma'at. Osiris vous accueille à Aaru, une Égypte sans fin où l'orge pousse plus haut qu'un homme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo cuore bilancia la piuma di Ma'at. Osiride ti accoglie ad Aaru, un Egitto senza fine dove l'orzo cresce più alto di un uomo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの心はマアトの羽根と釣り合いました。オシリスが、終わりのないエジプト、大麦が人の背より高く育つアアルへ迎えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 심장은 마아트의 깃털과 균형을 이룹니다. 오시리스가 아루로 당신을 맞이합니다. 끝없는 이집트, 보리가 사람보다 높이 자라는 곳입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje serce równoważy pióro Ma'at. Ozyrys wita cię w Aaru, Egipcie bez końca, gdzie jęczmień rośnie wyżej niż człowiek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu coração equilibra a pena de Ma'at. Osíris dá as boas-vindas a Aaru, um Egito sem fim onde a cevada cresce mais alta que um homem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心与玛阿特之羽持平。奥西里斯迎你进入阿鲁，那是一片无尽的埃及，大麦高过人身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心與瑪特之羽取得平衡。歐西里斯歡迎你來到阿魯，那是一片無盡的埃及，大麥高過人身。"
          }
        }
      }
    },
    "Your heart is lighter than the feather. You join Ra in his solar barque, sailing the sky by day and the underworld by night.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Herz ist leichter als die Feder. Du begleitest Ra in seiner Sonnenbarke, die tagsüber den Himmel und nachts die Unterwelt befährt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu corazón pesa menos que la pluma. Te unes a Ra en su barca solar, que surca el cielo de día y el inframundo de noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre cœur est plus léger que la plume. Vous rejoignez Ra sur sa barque solaire, qui navigue dans le ciel le jour et dans le monde souterrain la nuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo cuore è più leggero della piuma. Ti unisci a Ra sulla sua barca solare, a navigare il cielo di giorno e il mondo sotterraneo di notte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの心は羽根より軽い。ラーの太陽の舟に加わり、昼は空を、夜は冥界を渡ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 심장은 깃털보다 가볍습니다. 낮에는 하늘을, 밤에는 저승을 가르는 라의 태양선에 올라 그와 함께 항해합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje serce jest lżejsze od pióra. Dołączasz do Ra w jego słonecznej łodzi, żeglując po niebie za dnia i po zaświatach w nocy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu coração é mais leve que a pena. Você se junta a Rá em sua barca solar, navegando o céu de dia e o submundo de noite."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心比羽毛还轻。你随拉神登上日船，白天航行于天空，夜晚航行于冥界。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心比羽毛還輕。你與拉同乘太陽船，白天航行天空，夜晚穿越冥界。"
          }
        }
      }
    },
    "Your heart is weighed against the feather of Ma'at": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Herz wird gegen die Feder der Ma'at gewogen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu corazón se pesa contra la pluma de Ma'at"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre cœur est pesé contre la plume de Ma'at"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo cuore viene pesato contro la piuma di Ma'at"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの心をマアトの羽根と天秤にかけています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 심장을 마아트의 깃털과 저울에 답니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje serce jest ważone z piórem Ma'at"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu coração é pesado contra a pena de Ma'at"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心正在与玛阿特之羽称量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心正與瑪特之羽相秤"
          }
        }
      }
    },
    "Your heart outweighs the feather, and Ammit, part crocodile, part lion, part hippo, devours it. Egyptians were buried with a heart scarab so their heart would not testify against them. Consider one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Herz wiegt schwerer als die Feder, und Ammit, halb Krokodil, halb Löwe, halb Nilpferd, verschlingt es. Ägypter wurden mit einem Herzskarabäus bestattet, damit ihr Herz nicht gegen sie aussagt. Schau dir einen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu corazón pesa más que la pluma, y Ammit, mitad cocodrilo, mitad león, mitad hipopótamo, lo devora. Los egipcios se enterraban con un escarabeo de corazón para que su corazón no testificara en su contra. Considera uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre cœur est plus lourd que la plume, et Ammit, mi-crocodile, mi-lion, mi-hippopotame, le dévore. Les Égyptiens étaient enterrés avec un scarabée du cœur pour que leur cœur ne témoigne pas contre eux. Pensez-y."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo cuore pesa più della piuma, e Ammit, metà coccodrillo, metà leone, metà ippopotamo, lo divora. Gli egizi venivano sepolti con uno scarabeo del cuore, perché il loro cuore non testimoniasse contro di loro. Considerane uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの心は羽根より重く、ワニと獅子とカバが混ざった姿のアメミットがそれを喰らいます。エジプトの人々は、心が自分に不利な証言をしないよう、心臓のスカラベと共に埋葬されました。一つ手に取ってみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 심장이 깃털보다 무거워, 악어와 사자와 하마가 뒤섞인 암미트가 그것을 삼켜 버립니다. 이집트인들은 심장이 자신을 고발하지 못하도록 심장 풍뎅이 부적과 함께 묻혔습니다. 하나 떠올려 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje serce waży więcej niż pióro, a Ammit, po części krokodyl, po części lew, po części hipopotam, je pożera. W Egipcie zmarłym kładziono na sercu skarabeusza, by serce nie zeznawało przeciwko nim. Spójrz na jednego z nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu coração pesa mais que a pena, e Ammit, meio crocodilo, meio leão, meio hipopótamo, o devora. Os egípcios eram enterrados com um escaravelho do coração para que o coração não testemunhasse contra eles. Considere um."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心比羽毛重，阿米特（半鳄鱼、半狮子、半河马）将它吞噬。古埃及人下葬时会佩戴心脏圣甲虫，好让心脏不为他们作证。不妨看看一枚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的心比羽毛重，阿米特（半鱷、半獅、半河馬的怪獸）將它吞噬。埃及人下葬時會放一枚心臟聖甲蟲，免得心臟替他們作證。不妨想想那枚聖甲蟲。"
          }
        }
      }
    },
    "Your merit ripens into rebirth among the devas, a bliss so long you forget that it ends.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Verdienst reift zur Wiedergeburt unter den Devas, einer Seligkeit so lang, dass du vergisst, dass sie endet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mérito madura en un renacimiento entre los devas, una dicha tan larga que olvidas que tiene fin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre mérite mûrit en renaissance parmi les devas, une béatitude si longue que vous oubliez qu'elle finit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo merito matura in rinascita tra i deva, una beatitudine così lunga che dimentichi che finisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの功徳は熟して、天の神々のもとへの再生となります。その至福はあまりに長く、終わりがあることさえ忘れてしまうほどです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 공덕은 데바들 사이에서 환생으로 익어 갑니다. 그 행복은 너무 길어서 끝이 있다는 것조차 잊게 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja zasługa dojrzewa w odrodzenie wśród dewów, w błogostan tak długi, że zapominasz, iż się kończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu mérito amadurece em renascimento entre os devas, uma bem-aventurança tão longa que você esquece que ela termina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的功德成熟，转生于天神之中，那福乐如此绵长，以至于你忘了它终会结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的功德成熟，轉生於天神之中，那份喜樂如此漫長，以至於你忘了它終有盡頭。"
          }
        }
      }
    },
    "Your soul is": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Seele ist"
          }
        },
        "es": {
          "stringUnit": {
