    "A gentle nudge at %@. You can change the time anytime in Settings.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En blid påmindelse kl. %@. Du kan til enhver tid ændre klokkeslættet i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine sanfte Erinnerung um %@. Die Uhrzeit kannst du jederzeit in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso suave a las %@. Puedes cambiar la hora cuando quieras en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lempeä muistutus klo %@. Voit vaihtaa kellonaikaa milloin tahansa asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit rappel à %@. Vous pouvez changer l'heure à tout moment dans Réglages."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljúf áminning klukkan %@. Þú getur breytt tímanum hvenær sem er í Stillingum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria discreto alle %@. Puoi cambiare l'orario in qualsiasi momento in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にそっとお知らせします。時刻は設定でいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 가볍게 알려 드려요. 시간은 설정에서 언제든 바꿀 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En mild påminnelse kl. %@. Du kan endre klokkeslettet når som helst i Innstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatne przypomnienie o %@. Godzinę możesz zmienić w dowolnej chwili w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete discreto às %@. Você pode mudar o horário a qualquer momento nos Ajustes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En mjuk påminnelse kl. %@. Du kan ändra tiden när som helst i Inställningar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将在 %@ 轻轻提醒你。你可以随时在「设置」中更改时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將在 %@ 輕輕提醒你。你可以隨時在「設定」中更改時間。"
          }
        }
      }
    },
    "A rating helps the next curious soul find App of the Dead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bewertung hilft der nächsten neugierigen Seele, App of the Dead zu finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une note aide la prochaine âme curieuse à trouver App of the Dead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una valoración ayuda a la próxima alma curiosa a encontrar App of the Dead."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una valutazione aiuta la prossima anima curiosa a trovare App of the Dead."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua avaliação ajuda a próxima alma curiosa a encontrar App of the Dead."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja ocena pomoże kolejnej ciekawej duszy znaleźć App of the Dead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "評価は、次に訪れる好奇心旺盛な魂が App of the Dead を見つける助けになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평점은 다음에 찾아올 호기심 많은 영혼이 App of the Dead를 발견하는 데 도움이 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若你喜欢，一个评分就能帮助下一位好奇的灵魂找到 App of the Dead。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若你喜歡，一個評分就能幫助下一位好奇的靈魂找到 App of the Dead。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En bedømmelse hjælper den næste nysgerrige sjæl med at finde App of the Dead."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvio auttaa seuraavaa uteliasta sielua löytämään App of the Dead -sovelluksen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Einkunn hjálpar næstu forvitnu sál að finna App of the Dead."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En vurdering hjelper neste nysgjerrige sjel med å finne App of the Dead."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett betyg hjälper nästa nyfikna själ att hitta App of the Dead."
          }
        }
      }
    },
