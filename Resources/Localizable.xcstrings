    "This frees %@ on this iPhone. If the Oracle needs the model again, it offers the download.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden %@ auf diesem iPhone frei. Braucht das Orakel das Modell erneut, bietet es den Download an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela libère %@ sur cet iPhone. Si l'Oracle a de nouveau besoin du modèle, il propose de le télécharger à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto libera %@ en este iPhone. Si el Oráculo vuelve a necesitar el modelo, te ofrecerá descargarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così si liberano %@ su questo iPhone. Se l'Oracolo avrà di nuovo bisogno del modello, ti proporrà di scaricarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso libera %@ neste iPhone. Se o Oráculo precisar do modelo de novo, ele oferecerá o download."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zwolni %@ na tym iPhonie. Jeśli Wyrocznia znów będzie potrzebować modelu, zaproponuje jego pobranie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone の %@ を解放します。オラクルが再びモデルを必要とするときは、ダウンロードを案内します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서 %@를 확보합니다. 오라클이 모델을 다시 필요로 하면 다운로드를 제안합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将在此 iPhone 上释放 %@。若神谕之后需要该模型，它会提供重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會在這支 iPhone 上釋放 %@。若神諭之後需要此模型，會再提供下載。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette frigør %@ på denne iPhone. Hvis Orakelet får brug for modellen igen, tilbyder det at hente den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä vapauttaa tältä iPhonelta %@. Jos oraakkeli tarvitsee mallin uudelleen, se tarjoaa latauksen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta losar %@ á þessum iPhone. Ef Véfréttin þarf líkanið aftur býðst niðurhal þess."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette frigjør %@ på denne iPhone-en. Hvis Orakelet trenger modellen igjen, tilbyr det å laste den ned på nytt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här frigör %@ på den här iPhonen. Om Oraklet behöver modellen igen erbjuds en ny hämtning."
          }
        }
      }
    },
    "This will reset all your progress for %@. You'll lose your XP and completed lessons.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette nulstiller alt dit fremskridt for %@. Du mister din XP og dine fuldførte lektioner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird dein gesamter Fortschritt für %@ zurückgesetzt. Deine XP und abgeschlossenen Lektionen gehen verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restablecerá todo tu progreso en %@. Perderás tus XP y las lecciones completadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä nollaa koko edistymisesi kohteessa %@. Menetät XP:si ja suoritetut oppitunnit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute votre progression sur %@ sera réinitialisée. Vous perdrez vos XP et vos leçons terminées."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta endurstillir alla framvindu þína fyrir %@. Þú missir XP og kláraðar kennslustundir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i tuoi progressi in %@ verranno azzerati. Perderai gli XP e le lezioni completate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の進捗がすべてリセットされます。獲得した XP と完了したレッスンは失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 진행 상황이 모두 재설정됩니다. 획득한 XP와 완료한 레슨을 잃게 됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette tilbakestiller all fremgangen din for %@. Du mister XP og fullførte leksjoner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zresetuje cały twój postęp w %@. Stracisz swoje punkty XP i ukończone lekcje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto vai redefinir todo o seu progresso em %@. Você perderá seus XP e as lições concluídas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här återställer alla dina framsteg för %@. Du förlorar din XP och dina avslutade lektioner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将重置你在%@的全部进度。你将失去已获得的 XP 与已完成的课程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將重置你在%@的全部進度。你將失去已獲得的 XP 與已完成的課程。"
          }
        }
      }
    },
