    "Purchases belong to your Apple Account and come back on any iPhone or iPad with Restore Purchases.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe gehören zu deinem Apple Account und kehren mit „Käufe wiederherstellen“ auf jedem iPhone oder iPad zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats sont liés à votre compte Apple et reviennent sur tout iPhone ou iPad via « Restaurer les achats »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras pertenecen a tu cuenta de Apple y vuelven a aparecer en cualquier iPhone o iPad con Restaurar compras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli acquisti appartengono al tuo Apple Account e tornano su qualsiasi iPhone o iPad con Ripristina acquisti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As compras pertencem à sua Conta Apple e voltam em qualquer iPhone ou iPad com Restaurar compras."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakupy należą do Twojego Konta Apple i wrócą na każdym iPhonie lub iPadzie dzięki funkcji Przywróć zakupy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入内容は Apple アカウントに紐づき、「購入を復元」を使えばどの iPhone や iPad でも戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 내역은 Apple 계정에 연결되어 있어, 구매 복원을 누르면 어떤 iPhone이나 iPad에서든 다시 가져올 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买项目归属于你的 Apple 账户，在任何 iPhone 或 iPad 上通过“恢复购买”即可找回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買項目屬於你的 Apple 帳號，在任何 iPhone 或 iPad 上透過「回復購買項目」即可找回。"
          }
        }
      }
    },
