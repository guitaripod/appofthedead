    "Rán, goddess of the sea, gathers you in her net. The drowned feast in her hall beneath the waves.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rán, havgudinden, samler dig i sit net. De druknede holder fest i hendes sal under bølgerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rán, die Meeresgöttin, fängt dich in ihrem Netz. Die Ertrunkenen feiern in ihrer Halle unter den Wellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rán, diosa del mar, te recoge en su red. Los ahogados festejan en su salón bajo las olas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rán, meren jumalatar, kerää sinut verkkoonsa. Hukkuneet juhlivat hänen salissaan aaltojen alla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rán, déesse de la mer, vous recueille dans son filet. Les noyés festoient dans sa salle sous les vagues."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Rán, hafgyðja, grípur þig í net sitt. Drukknaðir halda veislu í sal hennar undir öldunum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rán, dea del mare, ti raccoglie nella sua rete. Gli annegati banchettano nella sua sala sotto le onde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "海の女神ラーンが、あなたを網ですくい上げます。溺れた者たちは、波の下の館で宴を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바다의 여신 란이 그물로 당신을 거둬들입니다. 물에 빠진 이들은 파도 아래 그녀의 전당에서 잔치를 벌입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rán, havgudinnen, fanger deg i nettet sitt. De druknede feirer i salen hennes under bølgene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rán, bogini morza, zbiera cię w swoją sieć. Utonięci ucztują w jej sali pod falami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rán, deusa do mar, recolhe você em sua rede. Os afogados festejam no salão dela, sob as ondas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rán, havets gudinna, fångar in dig i sitt nät. De drunknade festar i hennes sal under vågorna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "海之女神兰用她的网将你收入怀中。溺亡者在她波涛之下的殿堂中宴饮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "海之女神蘭以網將你收攏。溺亡者在她位於浪下的大廳中宴飲。"
          }
        }
      }
    },
