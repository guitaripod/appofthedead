    "Fighting for something I love": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg kæmper for noget, jeg elsker"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kämpfe für etwas, das ich liebe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luchando por algo que amo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taistelen jonkin puolesta, jota rakastan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Me battre pour ce que j'aime"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Berst fyrir því sem ég elska"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Combattendo per qualcosa che amo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "愛するもののために戦って"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사랑하는 무언가를 위해 싸웠어요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjemper for noe jeg elsker"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Walka o coś, co kocham"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lutando por algo que amo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kämpar för något jag älskar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为所爱之物而战"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為我所愛的事物而戰"
          }
        }
      }
    },
