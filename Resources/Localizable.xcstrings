            "value": "Det eviga"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永恒者"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永恆者"
          }
        }
      }
    },
    "The Eternal requires a physical device to manifest divine wisdom.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det evige kræver en fysisk enhed for at manifestere guddommelig visdom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ewige braucht ein echtes Gerät, um göttliche Weisheit zu manifestieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Eterno necesita un dispositivo físico para manifestar la sabiduría divina."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuisuus tarvitsee fyysisen laitteen ilmentääkseen jumalallista viisautta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Éternel a besoin d'un appareil physique pour manifester la sagesse divine."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hið eilífa krefst raunverulegs tækis til að birta guðdómlega visku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Eterno ha bisogno di un dispositivo fisico per manifestare la saggezza divina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠なるものが神聖な叡智を顕すには実機が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영원자가 신성한 지혜를 드러내려면 실제 기기가 필요합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det evige krever en fysisk enhet for å vise guddommelig visdom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieczny potrzebuje fizycznego urządzenia, aby zamanifestować boską mądrość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Eterno precisa de um dispositivo físico para manifestar a sabedoria divina."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det eviga kräver en fysisk enhet för att manifestera gudomlig visdom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永恒者需要真机才能显现神圣的智慧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永恆者需要實體裝置才能顯現神聖的智慧。"
          }
        }
      }
    },
    "The Eternal's wisdom cannot be reached at this time. Please try again later.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det eviges visdom kan ikke nås i øjeblikket. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Weisheit des Ewigen ist derzeit nicht erreichbar. Bitte versuche es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sabiduría del Eterno no está al alcance ahora mismo. Inténtalo de nuevo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuisuuden viisauteen ei saada yhteyttä juuri nyt. Yritä myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sagesse de l'Éternel est hors d'atteinte pour l'instant. Veuillez réessayer plus tard."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki er hægt að ná til visku Hins eilífa eins og er. Reyndu aftur síðar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La saggezza dell'Eterno non è raggiungibile in questo momento. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "永遠なるものの叡智に今は届きません。しばらくしてからお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 영원자의 지혜에 닿을 수 없습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det eviges visdom kan ikke nås akkurat nå. Prøv igjen senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mądrość Wiecznego jest teraz niedostępna. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sabedoria do Eterno está fora de alcance no momento. Tente novamente mais tarde."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det evigas visdom kan inte nås just nu. Försök igen senare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此刻无法触及永恒者的智慧。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此刻無法觸及永恆者的智慧。請稍後再試。"
          }
        }
      }
    },
