          "stringUnit": {
            "state": "translated",
            "value": "Allar 21 leiðirnar og véfréttin opnast um leið og þú greiðir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i 21 percorsi e l'Oracle si sbloccano nel momento in cui paghi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お支払いが完了した瞬間、21の道とOracleが開きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제하는 순간 21개의 길과 Oracle이 열려요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 21 veier og orakelet åpnes så snart du betaler"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie 21 ścieżek i Oracle otwierają się w chwili płatności"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os 21 caminhos e o Oracle se abrem no momento em que você paga"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla 21 vägar och Oraklet öppnas i samma stund du betalar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款的那一刻，全部 21 条路径和 Oracle 即刻开启"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款的那一刻，全部 21 條路徑和 Oracle 即刻開啟"
          }
        }
      }
    },
