    "None. I make my own.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen. Jeg laver mine egne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keinen. Ich mache mir meinen eigenen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno. Hago el mío."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei yhtään. Teen omani."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun. Je trace le mien."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Enginn. Ég skapa minn eigin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna. Me ne faccio una mia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なし。自分で作ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "없어요. 내 길은 내가 만들어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen. Jeg lager mine egne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadnych. Tworzę własne."
          }
        },
        "pt-BR": {
