    "On iPhones without Apple Intelligence the Oracle downloads Gemma 4, available under the Apache 2.0 license, or on iPhones with less memory Gemma 3, provided under and subject to the Gemma Terms of Use.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf iPhones ohne Apple Intelligence lädt das Orakel Gemma 4 herunter, verfügbar unter der Apache 2.0-Lizenz, oder auf iPhones mit weniger Arbeitsspeicher Gemma 3, bereitgestellt unter und vorbehaltlich der Gemma-Nutzungsbedingungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur les iPhone sans Apple Intelligence, l'Oracle télécharge Gemma 4, disponible sous licence Apache 2.0, ou, sur les iPhone dotés de moins de mémoire, Gemma 3, fourni sous réserve des Conditions d'utilisation de Gemma."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iPhone sin Apple Intelligence, el Oráculo descarga Gemma 4, disponible con la licencia Apache 2.0, o, en iPhone con menos memoria, Gemma 3, proporcionado bajo las Condiciones de uso de Gemma y sujeto a ellas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su iPhone senza Apple Intelligence, l'Oracolo scarica Gemma 4, disponibile con licenza Apache 2.0, oppure, su iPhone con meno memoria, Gemma 3, fornito nei termini e alle condizioni d'uso di Gemma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em iPhones sem Apple Intelligence, o Oráculo baixa o Gemma 4, disponível sob a licença Apache 2.0, ou, em iPhones com menos memória, o Gemma 3, fornecido sob os Termos de Uso do Gemma e sujeito a eles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na iPhone'ach bez Apple Intelligence Wyrocznia pobiera Gemma 4, udostępnianą na licencji Apache 2.0, a na iPhone'ach z mniejszą ilością pamięci Gemma 3, udostępnianą na podstawie Warunków korzystania z Gemma i zgodnie z nimi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence に対応していない iPhone では、オラクルは Apache 2.0 ライセンスの Gemma 4 をダウンロードします。メモリの少ない iPhone では Gemma 3 をダウンロードします。Gemma 3 は Gemma 利用規約のもとで提供されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence를 지원하지 않는 iPhone에서는 오라클이 Apache 2.0 라이선스로 제공되는 Gemma 4를 내려받습니다. 메모리가 적은 iPhone에서는 Gemma 3를 내려받으며, 이는 Gemma 이용 약관에 따라 제공됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在未搭载 Apple 智能的 iPhone 上，神谕将下载采用 Apache 2.0 许可证的 Gemma 4；内存较少的 iPhone 则下载 Gemma 3，其依 Gemma 使用条款提供并受其约束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在未具備 Apple 智慧功能的 iPhone 上，神諭會下載採用 Apache 2.0 授權條款的 Gemma 4；記憶體較少的 iPhone 則下載 Gemma 3，依 Gemma 使用條款提供並受其約束。"
          }
        }
      }
    },
    "One-time payment of %@. Yours forever, no subscription.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmalzahlung von %@. Für immer deins, kein Abo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago único de %@. Tuyo para siempre, sin suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paiement unique de %@. À vous pour toujours, sans abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento unico di %@. Tuo per sempre, senza abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の買い切り。サブスクリプションなしで、ずっとあなたのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 1회 결제. 구독 없이 평생 소장합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorazowa płatność %@. Twoje na zawsze, bez subskrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento único de %@. Seu para sempre, sem assinatura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性支付 %@。永久拥有，无需订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次付清 %@。永久擁有，無需訂閱。"
          }
        }
      }
    },
