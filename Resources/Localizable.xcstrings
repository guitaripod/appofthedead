    "Annual plan starts at %@/year. Cancel anytime before.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Årsabonnement fra %@/år. Du kan opsige når som helst inden da."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach %@/Jahr. Vorher jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, %@/año. Cancela cuando quieras antes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuosittainen tilaus alkaen %@/v. Voit peruuttaa milloin tahansa ennen sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis %@/an. Résiliable à tout moment avant."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Árleg áskriftarleið byrjar á %@/ári. Hægt er að hætta við hvenær sem er áður."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi %@/anno. Puoi annullare in qualsiasi momento prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以降は年額%@。それまでならいつでも解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이후 연 %@. 그 전에 언제든 취소할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Årsabonnementet koster fra %@/år. Du kan kansellere når som helst før du blir belastet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potem %@/rok. Możesz anulować w każdej chwili wcześniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois, %@/ano. Cancele quando quiser antes disso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Årsabonnemanget börjar på %@/år. Avbryt när som helst innan dess."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后按 %@/年续订。在此之前可随时取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後按 %@/年續訂。在此之前可隨時取消。"
          }
        }
      }
    },
