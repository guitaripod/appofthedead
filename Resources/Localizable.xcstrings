    "%@ per month. Auto-renews until cancelled in Settings at least a day before each renewal.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pr. måned. Fornyes automatisk, medmindre du opsiger i Indstillinger senest en dag før hver fornyelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro Monat. Verlängert sich automatisch, bis du mindestens einen Tag vor der Verlängerung in den Einstellungen kündigst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al mes. Se renueva automáticamente hasta que lo canceles en Ajustes al menos un día antes de cada renovación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kuukaudessa. Uusiutuu automaattisesti, kunnes peruutat asetuksissa vähintään päivää ennen jokaista uusiutumista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par mois. Renouvellement automatique jusqu'à résiliation dans Réglages, au moins un jour avant chaque échéance."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ á mánuði. Endurnýjast sjálfkrafa þar til þú segir upp í Stillingum að minnsta kosti einum degi fyrir hverja endurnýjun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al mese. Si rinnova automaticamente finché non annulli in Impostazioni almeno un giorno prima di ogni rinnovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月額%@。各更新日の1日前までに設定で解約しない限り自動更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월 %@. 갱신일 최소 하루 전에 설정에서 취소하지 않으면 자동으로 갱신됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per måned. Fornyes automatisk til du kansellerer i Innstillinger minst én dag før hver fornyelse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ miesięcznie. Subskrypcja odnawia się automatycznie, dopóki nie anulujesz jej w Ustawieniach co najmniej dzień przed każdym odnowieniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por mês. Renova automaticamente até você cancelar nos Ajustes pelo menos um dia antes de cada renovação."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per månad. Förnyas automatiskt tills du avbryter i Inställningar minst en dag före varje förnyelse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月%@。除非在每次续订前至少一天于「设置」中取消，否则将自动续订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每月 %@。除非在每次續訂前至少一天於「設定」中取消，否則將自動續訂。"
          }
        }
      }
    },
    "%@ per year. Auto-renews until cancelled in Settings at least a day before each renewal.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pr. år. Fornyes automatisk, medmindre du opsiger i Indstillinger senest en dag før hver fornyelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pro Jahr. Verlängert sich automatisch, bis du mindestens einen Tag vor der Verlängerung in den Einstellungen kündigst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al año. Se renueva automáticamente hasta que lo canceles en Ajustes al menos un día antes de cada renovación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vuodessa. Uusiutuu automaattisesti, kunnes peruutat asetuksissa vähintään päivää ennen jokaista uusiutumista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par an. Renouvellement automatique jusqu'à résiliation dans Réglages, au moins un jour avant chaque échéance."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ á ári. Endurnýjast sjálfkrafa þar til þú segir upp í Stillingum að minnsta kosti einum degi fyrir hverja endurnýjun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ all'anno. Si rinnova automaticamente finché non annulli in Impostazioni almeno un giorno prima di ogni rinnovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年額%@。各更新日の1日前までに設定で解約しない限り自動更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연 %@. 갱신일 최소 하루 전에 설정에서 취소하지 않으면 자동으로 갱신됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per år. Fornyes automatisk til du kansellerer i Innstillinger minst én dag før hver fornyelse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rocznie. Subskrypcja odnawia się automatycznie, dopóki nie anulujesz jej w Ustawieniach co najmniej dzień przed każdym odnowieniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por ano. Renova automaticamente até você cancelar nos Ajustes pelo menos um dia antes de cada renovação."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per år. Förnyas automatiskt tills du avbryter i Inställningar minst en dag före varje förnyelse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每年%@。除非在每次续订前至少一天于「设置」中取消，否则将自动续订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每年 %@。除非在每次續訂前至少一天於「設定」中取消，否則將自動續訂。"
          }
        }
      }
    },
    "%@ runs entirely on your iPhone. About %@ GB, downloaded once.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kører helt på din iPhone. Cirka %@ GB, hentes kun én gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ läuft vollständig auf deinem iPhone. Etwa %2$@ GB, einmalig geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ funciona por completo en tu iPhone. Unos %2$@ GB, descargados una sola vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ toimii kokonaan iPhonellasi. Noin %@ GB, ladataan kerran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fonctionne entièrement sur votre iPhone. Environ %2$@ Go, téléchargés une seule fois."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ keyrir alfarið í iPhone-símanum þínum. Um %@ GB, sótt einu sinni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ funziona interamente sul tuo iPhone. Circa %2$@ GB, scaricati una sola volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はすべてiPhone上で動作します。約%2$@ GB、ダウンロードは一度きりです。"
