    "Freyja chooses first, and she chooses you. Half of the battle-slain go to her field, Fólkvangr.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Freyja vælger først, og hun vælger dig. Halvdelen af de faldne i kamp går til hendes mark, Fólkvangr."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freyja wählt zuerst, und sie wählt dich. Die Hälfte der im Kampf Gefallenen gehört ihrem Feld, Fólkvangr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Freyja elige primero, y te elige a ti. La mitad de los caídos en batalla van a su campo, Fólkvangr."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Freyja valitsee ensimmäisenä, ja hän valitsee sinut. Puolet taistelussa kaatuneista menee hänen kentälleen, Fólkvangriin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Freyja choisit en premier, et elle vous choisit. La moitié des tués au combat vont dans son champ, Fólkvangr."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Freyja velur fyrst, og hún velur þig. Helmingur hinna föllnu í bardaga fer á akur hennar, Fólkvangur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Freyja sceglie per prima, e sceglie te. Metà dei caduti in battaglia va al suo campo, Fólkvangr."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレイヤが最初に選び、彼女はあなたを選びました。戦死者の半分は彼女の野、フォルクヴァングへ行きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레이야가 먼저 고르고, 그녀가 당신을 택합니다. 전사한 이들의 절반은 그녀의 들판 폴크방그르로 갑니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Freyja velger først, og hun velger deg. Halvparten av de falne i kamp går til hennes mark, Fólkvangr."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Freyja wybiera pierwsza i wybiera ciebie. Połowa poległych w bitwie trafia na jej pole, Fólkvangr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Freyja escolhe primeiro, e escolhe você. Metade dos caídos em batalha vai para o campo dela, Fólkvangr."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Freja väljer först, och hon väljer dig. Hälften av de stupade går till hennes fält, Fólkvangr."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弗蕾娅先行挑选，她选中了你。阵亡者中有一半归她的原野——弗尔克万格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "芙蕾雅先選，她選中了你。戰死者的一半歸她所有，前往她的原野弗爾克旺。"
          }
        }
      }
    },
