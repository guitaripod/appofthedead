          "stringUnit": {
            "state": "translated",
            "value": "現在離開將不會儲存你的進度。"
          }
        }
      }
    },
    "Your purchase is waiting for approval. It unlocks by itself once it is approved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Genehmigung. Er wird automatisch freigeschaltet, sobald er genehmigt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está esperando aprobación. Se desbloquea sola en cuanto se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat est en attente d'approbation. Il se débloque tout seul dès qu'il est approuvé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in attesa di approvazione. Si sblocca da solo non appena viene approvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。承認されると自動的に利用できるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매가 승인을 기다리고 있습니다. 승인되면 자동으로 잠금이 해제됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój zakup czeka na zatwierdzenie. Odblokuje się samoczynnie po zatwierdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra está aguardando aprovação. Ela é liberada sozinha assim que for aprovada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的购买正在等待批准。批准后将自动解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的購買正在等待核准。核准後將自動解鎖。"
          }
        }
      }
    },
    "Your purchases could not be restored. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Käufe konnten nicht wiederhergestellt werden. Bitte versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron restaurar tus compras. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos achats n'ont pas pu être restaurés. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile ripristinare i tuoi acquisti. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を復元できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매를 복원할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się przywrócić zakupów. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível restaurar suas compras. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复你的购买项目。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法還原你的購買項目。請再試一次。"
          }
        }
      }
    },
