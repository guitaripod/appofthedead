    "The scales have spoken.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vægten har talt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Waage hat gesprochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La balanza ha hablado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaa'at ovat puhuneet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La balance a parlé."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vogin hefur talað."
          }
        },
        "it": {
