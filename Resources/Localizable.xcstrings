    "Annual plan starts at %@/year. Cancel anytime before.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach %@/Jahr. Vorher jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, %@/año. Cancela cuando quieras antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis %@/an. Résiliable à tout moment avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi %@/anno. Puoi annullare in qualsiasi momento prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以降は年額%@。それまでならいつでも解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이후 연 %@. 그 전에 언제든 취소할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potem %@/rok. Możesz anulować w każdej chwili wcześniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois, %@/ano. Cancele quando quiser antes disso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后按 %@/年续订。在此之前可随时取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後按 %@/年續訂。在此之前可隨時取消。"
          }
        }
      }
    },
