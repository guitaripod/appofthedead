    "Welcome back. Everything you own is unlocked again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Velkommen tilbage. Alt, du ejer, er låst op igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen zurück. Alles, was dir gehört, ist wieder freigeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenido de nuevo. Todo lo que tienes vuelve a estar desbloqueado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tervetuloa takaisin. Kaikki omistamasi on taas avattu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon retour. Tout ce que vous possédez est de nouveau débloqué."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Velkomin aftur. Allt sem þú átt er aftur opnað."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bentornato. Tutto ciò che possiedi è di nuovo sbloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おかえりなさい。購入済みのものはすべて再び解放されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 오셨군요. 보유하신 모든 항목이 다시 열렸습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velkommen tilbake. Alt du eier er låst opp igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Witaj ponownie. Wszystko, co posiadasz, jest znowu odblokowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que bom ter você de volta. Tudo o que é seu está liberado de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välkommen tillbaka. Allt du äger är upplåst igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎回来。你拥有的一切已重新解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎回來。你擁有的一切已重新解鎖。"
          }
        }
      }
    },
