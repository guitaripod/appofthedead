            "value": "あなたの魂は"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 영혼은"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja dusza to"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua alma é"
          }
        },
        "zh-Hans": {
          "stringUnit": {
