        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 전부 iPhone에서 실행됩니다. 약 %2$@GB이며 한 번만 다운로드합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kjører helt på iPhonen din. Omtrent %@ GB, lastes ned én gang."
