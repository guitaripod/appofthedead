          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din själs öde i den här traditionen: %@. Den här vägen berättar hela historien."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的灵魂在这一传统中的归宿：%@。这条路径会讲述完整的故事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的靈魂在這一傳統中的歸宿：%@。這條路徑會講述完整的故事。"
          }
        }
      }
    },
