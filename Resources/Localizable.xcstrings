            "value": "永遠なるもの"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영원자"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det evige"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieczny"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Eterno"
          }
        },
        "sv": {
          "stringUnit": {
