    "Six afterlives just judged my soul. I'm %@. Where will yours go?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs Jenseitsvorstellungen haben gerade meine Seele gerichtet. Ich bin %@. Wohin wird deine gehen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis vidas después de la muerte acaban de juzgar mi alma. Soy %@. ¿Adónde irá la tuya?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six vies après la mort viennent de juger mon âme. Je suis %@. Où ira la vôtre ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei aldilà hanno appena giudicato la mia anima. Sono %@. E la tua dove andrà?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "六つの死後の世界が、たった今私の魂を審判しました。私は%@です。あなたの魂はどこへ行くでしょう？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여섯 개의 내세가 방금 내 영혼을 심판했어요. 나는 %@이에요. 당신의 영혼은 어디로 갈까요?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sześć zaświatów właśnie osądziło moją duszę. Jestem %@. Dokąd pójdzie twoja?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis vidas após a morte acabaram de julgar a minha alma. Eu sou %@. Para onde a sua vai?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "六种死后世界刚刚审判了我的灵魂。我是%@。你的灵魂将去往何方？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "六種死後世界剛剛審判了我的靈魂。我是%@。你的靈魂會去哪裡？"
          }
        }
      }
    },
