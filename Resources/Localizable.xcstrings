    "Your word outlives you. In every tradition here, a kept promise weighs more than gold.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit ord overlever dig. I hver tradition her vejer et overholdt løfte mere end guld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wort überdauert dich. In jeder Tradition hier wiegt ein gehaltenes Versprechen mehr als Gold."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu palabra te sobrevive. En todas las tradiciones de aquí, una promesa cumplida pesa más que el oro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanasi elää sinua pidempään. Kaikissa täällä esitellyissä perinteissä pitämäsi lupaus painaa enemmän kuin kulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre parole vous survit. Dans chacune de ces traditions, une promesse tenue pèse plus que l'or."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Orð þitt lifir lengur en þú. Í sérhverri hefð hér vegur loforð sem staðið er við þyngra en gull."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua parola ti sopravvive. In ogni tradizione qui, una promessa mantenuta pesa più dell'oro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの言葉は、あなたより長く生きます。ここに挙げたどの伝統においても、守られた約束は黄金より重いのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 말은 당신보다 오래 남습니다. 여기 모든 전통에서 지킨 약속은 금보다 무겁습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordet ditt overlever deg. I alle tradisjoner her veier et holdt løfte mer enn gull."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje słowo przeżyje ciebie. We wszystkich tych tradycjach dotrzymana obietnica waży więcej niż złoto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua palavra sobrevive a você. Em todas as tradições aqui, uma promessa cumprida pesa mais que ouro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt ord överlever dig. I varje tradition här väger ett infriat löfte mer än guld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的话语比你活得更久。在这里的每一种传统中，践守的承诺都比黄金更重。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的話語將比你存活得更久。在這裡每一種信仰中，守住的承諾都比黃金更重。"
          }
        }
      }
    },
