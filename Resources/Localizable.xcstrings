            "state": "translated",
            "value": "El manifiesto del modelo estaba vacío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le manifeste du modèle était vide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manifesto del modello era vuoto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのマニフェストが空でした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 매니페스트가 비어 있습니다."
