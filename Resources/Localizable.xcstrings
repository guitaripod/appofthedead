    "Your soul's fate in this tradition: %@. This path tells the whole story.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din sjæls skæbne i denne tradition: %@. Denne vej fortæller hele historien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schicksal deiner Seele in dieser Tradition: %@. Dieser Pfad erzählt die ganze Geschichte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El destino de tu alma en esta tradición: %@. Este camino cuenta toda la historia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sielusi kohtalo tässä perinteessä: %@. Tämä polku kertoo koko tarinan."
          }
        },
        "fr": {
          "stringUnit": {
