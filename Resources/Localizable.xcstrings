            "state": "translated",
            "value": "La bilancia ha parlato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天秤が語りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저울이 말했어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vekten har talt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waga przemówiła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A balança falou."
          }
        },
        "sv": {
          "stringUnit": {
