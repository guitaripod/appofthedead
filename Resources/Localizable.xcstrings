            "state": "translated",
            "value": "項目をタップして、対応するものをタップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 탭한 다음 짝을 탭하세요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
