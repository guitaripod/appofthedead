    "%@ and every other path are one step away.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ og alle andre veje er ét skridt væk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ und alle anderen Pfade sind nur einen Schritt entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y todos los demás caminos están a un paso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ja kaikki muut polut ovat yhden askeleen päässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ et tous les autres parcours ne sont plus qu'à un pas."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ og allar aðrar leiðir eru einu skrefi í burtu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ e tutti gli altri percorsi sono a un passo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ や他のすべての道も、あと一歩です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 및 다른 모든 길도 한 걸음 거리에 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ og alle andre veier er ett steg unna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ i każda inna ścieżka są o krok stąd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ e todos os outros caminhos estão a um passo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ och alla andra vägar är ett steg bort."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 和其他所有路径只需一步即可抵达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 和其他所有路徑只要一步就能到達。"
          }
        }
      }
    },
