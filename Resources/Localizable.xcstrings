    "Pay, and step aboard": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Betal, og gå om bord"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlen und an Bord gehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga y sube a bordo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksa ja astu kyytiin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payer, et monter à bord"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Borgaðu og stígðu um borð"
          }
        },
        "it": {
