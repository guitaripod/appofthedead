    "Plans couldn't be loaded. Check your connection and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementerne kunne ikke indlæses. Kontrollér din forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tarife konnten nicht geladen werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido cargar los planes. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilausvaihtoehtoja ei voitu ladata. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les formules. Vérifiez votre connexion et réessayez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að hlaða áskriftarleiðirnar. Athugaðu tenginguna og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare i piani. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランを読み込めませんでした。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요금제를 불러오지 못했습니다. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementene kunne ikke lastes. Kontroller tilkoblingen og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać planów. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar os planos. Verifique sua conexão e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnemangen kunde inte läsas in. Kontrollera anslutningen och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入订阅方案。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入訂閱方案。請檢查網路連線後再試一次。"
          }
        }
      }
    },
    "Practice Again": {
      "localizations": {
        "da": {
          "stringUnit": {
