    "Those taken by water or lightning go to Tlalocan, the rain god's garden of endless spring.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer vom Wasser oder vom Blitz geholt wurde, geht nach Tlalocan, dem Garten des Regengottes mit ewigem Frühling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quienes se llevan el agua o el rayo van a Tlalocan, el jardín de la primavera eterna del dios de la lluvia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceux emportés par l'eau ou la foudre vont à Tlalocan, le jardin du dieu de la pluie, où règne un printemps éternel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi è portato via dall'acqua o dal fulmine va a Tlalocan, il giardino del dio della pioggia, di una primavera senza fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水や雷に命を奪われた者は、雨の神の、終わることのない春の庭トラロカンへ行きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물이나 번개에 목숨을 잃은 이들은 비의 신의 정원, 끝없는 봄의 땅 틀랄로칸으로 갑니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci, których zabrała woda lub piorun, trafiają do Tlalocan, ogrodu boga deszczu, wiecznej wiosny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os levados pela água ou pelo raio vão para Tlalocan, o jardim da primavera sem fim do deus da chuva."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因水或雷电而死的人将前往特拉洛坎，那是雨神的永春花园。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因水或雷電而逝者，前往特拉洛克潘，那是雨神的永春花園。"
          }
        }
      }
    },
