    "Tell it gently, and help carry the cost": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortæl det blidt, og hjælp med at bære prisen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag es sanft und hilf, die Last zu tragen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilo con delicadeza y ayuda a cargar con el coste"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro se lempeästi ja auta kantamaan seuraukset"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dire avec douceur, et aider à porter le coût"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Segðu það varlega og taktu þátt í að bera kostnaðinn"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilla con dolcezza, e aiuta a sostenerne il costo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "優しく伝え、代償も分かち合う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드럽게 말하고 대가도 함께 짊어진다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Si det forsiktig, og hjelp til å bære kostnaden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz łagodnie i pomóż ponieść koszt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contar com gentileza e ajudar a arcar com o custo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berätta försiktigt och hjälp till att bära kostnaden"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温和地说出，并一起承担代价"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫和地說，並幫忙分擔代價"
          }
        }
      }
    },
