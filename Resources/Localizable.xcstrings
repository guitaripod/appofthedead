    "Six afterlives just judged my soul. I'm %@. Where will yours go?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Seks efterlivsforestillinger har lige dømt min sjæl. Jeg er %@. Hvor havner din?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs Jenseitsvorstellungen haben gerade meine Seele gerichtet. Ich bin %@. Wohin wird deine gehen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis vidas después de la muerte acaban de juzgar mi alma. Soy %@. ¿Adónde irá la tuya?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuusi kuoleman jälkeistä elämää juuri tuomitsi sieluni. Olen %@. Minne sinun sielusi menee?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six vies après la mort viennent de juger mon âme. Je suis %@. Où ira la vôtre ?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sex eftirlífsheimar voru að dæma sál mína. Ég er %@. Hvert fer þín?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei aldilà hanno appena giudicato la mia anima. Sono %@. E la tua dove andrà?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "六つの死後の世界が、たった今私の魂を審判しました。私は%@です。あなたの魂はどこへ行くでしょう？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여섯 개의 내세가 방금 내 영혼을 심판했어요. 나는 %@이에요. 당신의 영혼은 어디로 갈까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Seks liv etter døden har nettopp dømt sjelen min. Jeg er %@. Hvor havner din?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sześć zaświatów właśnie osądziło moją duszę. Jestem %@. Dokąd pójdzie twoja?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis vidas após a morte acabaram de julgar a minha alma. Eu sou %@. Para onde a sua vai?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sex efterliv just dömde min själ. Jag är %@. Vart tar din själ vägen?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "六种死后世界刚刚审判了我的灵魂。我是%@。你的灵魂将去往何方？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "六種死後世界剛剛審判了我的靈魂。我是%@。你的靈魂會去哪裡？"
          }
        }
      }
    },
    "Six traditions weigh your heart in two minutes.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Seks traditioner vejer dit hjerte på to minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sechs Traditionen wiegen dein Herz in zwei Minuten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis tradiciones pesan tu corazón en dos minutos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuusi perinnettä punnitsee sydämesi kahdessa minuutissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six traditions pèsent votre cœur en deux minutes."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sex trúarhefðir vega hjarta þitt á tveimur mínútum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei tradizioni pesano il tuo cuore in due minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "六つの伝統が2分であなたの心を量ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여섯 전통이 2분 만에 당신의 마음을 달아 봅니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Seks tradisjoner veier hjertet ditt på to minutter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sześć tradycji waży twoje serce w dwie minuty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis tradições pesam seu coração em dois minutos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sex traditioner väger ditt hjärta på två minuter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "六种传统在两分钟内称量你的心。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "六種信仰在兩分鐘內秤量你的心。"
          }
        }
      }
    },
    "Skip to the lessons": {
      "localizations": {
        "da": {
