    "This Apple Account has no earlier purchases to restore.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Apple Account hat keine früheren Käufe zum Wiederherstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte Apple n'a aucun achat antérieur à restaurer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta de Apple no tiene compras anteriores que restaurar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Apple Account non ha acquisti precedenti da ripristinare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta Conta Apple não tem compras anteriores para restaurar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To Konto Apple nie ma wcześniejszych zakupów do przywrócenia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Apple アカウントには、復元できる過去の購入はありません。"
