    "Fallen warriors escort the sun across the sky for four years, then return to the earth as hummingbirds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefallene Krieger geleiten die Sonne vier Jahre lang über den Himmel und kehren dann als Kolibris zur Erde zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los guerreros caídos escoltan al sol por el cielo durante cuatro años y luego vuelven a la tierra como colibríes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les guerriers tombés escortent le soleil dans le ciel pendant quatre ans, puis retournent sur terre sous forme de colibris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I guerrieri caduti scortano il sole attraverso il cielo per quattro anni, poi tornano sulla terra come colibrì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "倒れた戦士たちは四年間、太陽を空の向こうまで導き、そのあと地上へハチドリとなって戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰러진 전사들은 4년 동안 해를 호위하며 하늘을 건넌 뒤, 벌새가 되어 지상으로 돌아옵니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polegli wojownicy towarzyszą słońcu na niebie przez cztery lata, po czym wracają na ziemię jako kolibry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guerreiros caídos escoltam o sol pelo céu por quatro anos e depois retornam à terra como beija-flores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阵亡的战士护送太阳穿越天空四年，然后化作蜂鸟重返大地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "陣亡的戰士陪伴太陽穿越天空四年，然後化為蜂鳥回到大地。"
          }
        }
      }
    },
