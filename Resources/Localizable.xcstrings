            "value": "Tryk på et element, og tryk derefter på dets par"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Element antippen, dann sein Gegenstück"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un elemento y luego su pareja"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta kohdetta ja napauta sitten sen paria"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un élément, puis son équivalent"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýttu á atriði og síðan á samsvörun þess"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un elemento, poi il suo abbinamento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目をタップして、対応するものをタップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 탭한 다음 짝을 탭하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på et element, og trykk så på det som hører sammen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij element, a potem jego parę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um item e depois no seu par"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ett objekt och tryck sedan på dess par"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一项，再轻点与之配对的一项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下項目，再點一下與它配對的項目"
          }
        }
      }
    },
    "Tap to select, then tap an item in the other column to form a pair": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at vælge, og tryk derefter på et element i den anden kolonne for at danne et par"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Auswählen tippen, dann ein Element in der anderen Spalte antippen, um ein Paar zu bilden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para seleccionar y luego toca un elemento de la otra columna para formar una pareja"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta valitaksesi, napauta sitten toisen sarakkeen kohdetta muodostaaksesi parin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour sélectionner, puis touchez un élément de l'autre colonne pour former une paire"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýttu til að velja og síðan á atriði í hinum dálknum til að mynda par"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per selezionare, poi tocca un elemento dell'altra colonna per formare una coppia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして選び、もう一方の列の項目をタップすると対になります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭해서 선택한 뒤 다른 열의 항목을 탭하면 짝이 됩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å velge, og trykk deretter på et element i den andre kolonnen for å danne et par"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby wybrać, a potem stuknij element w drugiej kolumnie, aby utworzyć parę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para selecionar e depois toque em um item da outra coluna para formar um par"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att välja och tryck sedan på ett objekt i den andra kolumnen för att bilda ett par"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点选择，然后轻点另一列中的项目即可配对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下以選取，再點一下另一欄中的項目即可配對"
          }
        }
      }
    },
