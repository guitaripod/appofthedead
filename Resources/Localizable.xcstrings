    "Pride carries you to the asuras, demigods forever at war with the gods.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stolz trägt dich zu den Asuras, Halbgöttern, die ewig mit den Göttern im Krieg liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El orgullo te lleva a los asuras, semidioses en guerra eterna con los dioses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'orgueil vous mène chez les asuras, demi-dieux à jamais en guerre contre les dieux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'orgoglio ti porta tra gli asura, semidei in guerra eterna con gli dèi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "驕りがあなたを阿修羅へと運びます。神々と永遠に争い続ける半神の世界です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교만이 당신을 아수라에게로 데려갑니다. 신들과 늘 싸우는 반신들입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duma prowadzi cię do asurów, półbogów wiecznie walczących z bogami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O orgulho leva você aos asuras, semideuses para sempre em guerra com os deuses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "骄慢将你带往阿修罗界，那些半神永远与诸神交战。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驕傲將你帶往阿修羅道，那是永遠與諸神交戰的半神。"
          }
        }
      }
    },
