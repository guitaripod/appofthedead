          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Sua %lld lição concluída fica exatamente onde você parou. Mantenha todos os caminhos e todos os deuses abertos."
                }
