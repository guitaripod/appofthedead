    "What every culture believes comes after": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad enhver kultur tror kommer bagefter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was jede Kultur für das Danach glaubt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que toda cultura cree que viene después"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä jokainen kulttuuri uskoo kuoleman jälkeen tulevan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que chaque culture croit qui vient après"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það sem hver menning trúir að komi á eftir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che ogni cultura crede venga dopo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての文化が信じる、死後に訪れるもの"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 문화가 믿어 온 죽음 뒤의 세계"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det alle kulturer tror kommer etterpå"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co według każdej kultury nadchodzi potem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que toda cultura acredita vir depois"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad alla kulturer tror kommer efter"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各种文化所相信的死后世界"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每種文化所相信的死後世界"
          }
        }
      }
    },
    "Where will your soul go?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor vil din sjæl gå hen?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohin wird deine Seele gehen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Adónde irá tu alma?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Minne sielusi menee?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où ira votre âme ?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert fer sál þín?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove andrà la tua anima?"
          }
        },
        "ja": {
          "stringUnit": {
