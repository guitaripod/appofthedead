    "Reminder set for %@ every day. You can change it anytime in Settings.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Påmindelsen er indstillet til %@ hver dag. Du kan ændre den når som helst i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung für täglich %@ eingestellt. Du kannst sie jederzeit in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorio programado todos los días a las %@. Puedes cambiarlo cuando quieras en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
