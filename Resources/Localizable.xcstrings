    "Including the six afterlives that judged your soul": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Heriblandt de seks efterlivsforestillinger, der dømte din sjæl"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darunter die sechs Jenseitsvorstellungen, die deine Seele gerichtet haben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluidas las seis vidas después de la muerte que juzgaron tu alma"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukana ne kuusi kuoleman jälkeistä elämää, jotka tuomitsivat sielusi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dont les six vies après la mort qui ont jugé votre âme"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þar á meðal eftirlífsheimarnir sex sem dæmdu sál þína"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compresi i sei aldilà che hanno giudicato la tua anima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの魂を審判した六つの死後の世界も含まれます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 영혼을 심판한 여섯 개의 내세도 포함돼요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkludert de seks livene etter døden som dømte sjelen din"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym sześć zaświatów, które osądziły twoją duszę"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluindo as seis vidas após a morte que julgaram a sua alma"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inklusive de sex efterliv som dömde din själ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包括审判了你灵魂的六种死后世界"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包括審判了你靈魂的六種死後世界"
          }
        }
      }
    },
    "%@, your guide from the Judgment, and 20 more": {
