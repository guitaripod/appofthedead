    "Thoth unrolls the record of your life. Which line runs longest?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoth rollt die Aufzeichnung deines Lebens aus. Welche Zeile ist die längste?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoth despliega el registro de tu vida. ¿Qué línea es la más larga?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thot déroule le registre de votre vie. Quelle ligne est la plus longue ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoth srotola la cronaca della tua vita. Quale riga è la più lunga?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トートがあなたの人生の記録を広げます。最も長い行はどれでしょう？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토트가 당신 삶의 기록을 펼칩니다. 어느 줄이 가장 길까요?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Thot rozwija zwój twojego życia. Która linia biegnie najdłużej?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoth desenrola o registro da sua vida. Qual linha é a mais longa?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "托特展开你一生的记录。哪一行最长？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "托特展開你一生的紀錄。哪一行最長？"
          }
        }
      }
    },
