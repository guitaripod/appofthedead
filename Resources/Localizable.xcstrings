          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この伝統でのあなたの魂の行き先：%@。この道がそのすべてを語ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 전통에서 당신 영혼의 운명: %@. 이 길이 그 모든 이야기를 들려줘요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjebnen til sjelen din i denne tradisjonen: %@. Denne veien forteller hele historien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Los twojej duszy w tej tradycji: %@. Ta ścieżka opowiada całą historię."
