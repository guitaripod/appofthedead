    "%@ could not answer just now.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kunne ikke svare lige nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte gerade nicht antworten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener la respuesta de %@ en este momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei voinut vastata juuri nyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse de %@ n'a pas pu aboutir pour l'instant."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gat ekki svarað núna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile ottenere la risposta di %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は今は答えられませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 지금은 답변할 수 없었습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kunne ikke svare akkurat nå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się teraz uzyskać odpowiedzi od %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter a resposta de %@ agora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kunde inte svara just nu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@刚才无法作答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@剛才無法作答。"
          }
        }
      }
    },
