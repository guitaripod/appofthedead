    "Truths I told when lying was easier": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandheder, jeg fortalte, da det var lettere at lyve"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wahrheiten, die ich sagte, obwohl Lügen leichter gewesen wäre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdades que dije cuando mentir era más fácil"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Totuudet, jotka kerroin, kun valehtelu oli helpompaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérités dites alors que mentir était plus facile"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sannleikur sem ég sagði þegar það var auðveldara að ljúga"
