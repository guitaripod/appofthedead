    "Thoth unrolls the record of your life. Which line runs longest?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoth ruller din livs optegnelse ud. Hvilken linje er længst?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoth rollt die Aufzeichnung deines Lebens aus. Welche Zeile ist die längste?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoth despliega el registro de tu vida. ¿Qué línea es la más larga?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoth rullaa auki elämäsi kirjauksen. Mikä rivi on pisin?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thot déroule le registre de votre vie. Quelle ligne est la plus longue ?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoth rúllar út skrá lífs þíns. Hvaða lína er lengst?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoth srotola la cronaca della tua vita. Quale riga è la più lunga?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トートがあなたの人生の記録を広げます。最も長い行はどれでしょう？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토트가 당신 삶의 기록을 펼칩니다. 어느 줄이 가장 길까요?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoth ruller ut oversikten over livet ditt. Hvilken linje er lengst?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Thot rozwija zwój twojego życia. Która linia biegnie najdłużej?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoth desenrola o registro da sua vida. Qual linha é a mais longa?"
          }
        },
