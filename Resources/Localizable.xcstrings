    "Great job! You haven't made any mistakes in this path.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flot! Du har ikke lavet nogen fejl på denne vej."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stark! Auf diesem Pfad hast du keinen Fehler gemacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Muy bien! No has cometido ningún error en este camino."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hienoa työtä! Et ole tehnyt yhtään virhettä tällä polulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bravo ! Vous n'avez fait aucune erreur sur cette voie."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Frábært! Þú hefur ekki gert neinar villur á þessari leið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimo! Non hai commesso errori in questo percorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お見事。この道では一つも間違いがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "훌륭해요! 이 길에서 틀린 문제가 하나도 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bra jobbet! Du har ikke gjort noen feil på denne veien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Świetna robota! Na tej ścieżce nie ma żadnego błędu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muito bem! Você não errou nada neste caminho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bra jobbat! Du har inte gjort några misstag i den här vägen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太棒了！你在这条路径上没有答错任何一题。"
