          }
        }
      }
    },
    "Yama": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヤマ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "야마"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jama"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阎摩"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閻摩"
          }
        }
      }
    },
    "Yama holds up the mirror of karma. It shows what you cling to most.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama holder karmaens spejl op. Det viser, hvad du klynger dig mest til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama hält dir den Spiegel des Karma vor. Er zeigt, woran du am meisten hängst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama sostiene el espejo del karma. Muestra a qué te aferras más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama pitelee karman peiliä. Se näyttää, mihin takerrut eniten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama tend le miroir du karma. Il montre à quoi vous tenez le plus."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama heldur upp spegli karmans. Hann sýnir það sem þú heldur fastast í."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama alza lo specchio del karma. Mostra ciò a cui ti aggrappi di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヤマがカルマの鏡を掲げます。そこに映るのは、あなたが最も執着しているものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "야마가 업의 거울을 들어 올립니다. 당신이 가장 집착하는 것을 비춰 보입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama holder frem karmaens speil. Det viser hva du klamrer deg mest til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jama podnosi lustro karmy. Pokazuje to, czego najbardziej się trzymasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama ergue o espelho do carma. Ele mostra aquilo a que você mais se apega."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Yama håller upp karmans spegel. Den visar vad du håller fast vid mest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阎摩举起业镜。它映照出你最执着的东西。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閻摩舉起業鏡，映出你最執著的事物。"
          }
        }
      }
    },
    "You are reborn human: the rarest birth, and the only one from which awakening is possible.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du genfødes som menneske: den sjældneste fødsel, og den eneste, hvorfra opvågnen er mulig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst als Mensch wiedergeboren: die seltenste Geburt, und die einzige, aus der Erwachen möglich ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renaces como humano: el nacimiento más raro, y el único desde el que el despertar es posible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet syntynyt uudelleen ihmisenä: harvinaisin syntymä, ja ainoa, josta herääminen on mahdollista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous renaissez humain : la naissance la plus rare, et la seule à partir de laquelle l'éveil est possible."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú fæddist aftur sem manneskja: sjaldgæfasta fæðingin, og sú eina þar sem vakning er möguleg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinasci umano: la nascita più rara, e l'unica dalla quale il risveglio è possibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは人間として生まれ変わります。最も稀な生であり、目覚めへ至ることのできる唯一の生です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 인간으로 다시 태어납니다. 가장 드문 태어남이며, 깨달음이 가능한 유일한 태어남입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er født på nytt som menneske: den sjeldneste fødselen, og den eneste der oppvåkning er mulig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odradzasz się jako człowiek: to najrzadsze narodziny, jedyne, z których przebudzenie jest możliwe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você renasce humano: o nascimento mais raro, e o único a partir do qual o despertar é possível."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är född på nytt som människa: den sällsyntaste födelsen, och den enda som gör uppvaknande möjligt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你转生为人：这是最罕见的出生，也是唯一能够觉悟的一世。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你轉生為人：這是最稀有的誕生，也是唯一可以覺醒的一種。"
          }
        }
      }
    },
    "You cling to almost nothing. The wheel of rebirth can barely hold you, and awakening is close.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du klynger dig næsten til intet. Genfødselshjulet kan knap nok holde dig, og opvågnen er nær."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hältst kaum an etwas fest. Das Rad der Wiedergeburt kann dich kaum halten, und das Erwachen ist nah."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi no te aferras a nada. La rueda del renacimiento apenas puede retenerte, y el despertar está cerca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et takerru lähes mihinkään. Jälleensyntymisen pyörä tuskin pitää sinua, ja herääminen on lähellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne vous accrochez presque à rien. La roue de la renaissance peine à vous retenir, et l'éveil est proche."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú heldur fast í nánast engu. Hjól endurfæðingarinnar getur varla haldið þér, og vakningin er nærri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ti aggrappi quasi a nulla. La ruota della rinascita fatica a trattenerti, e il risveglio è vicino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたはほとんど何にも執着していません。輪廻の車輪もあなたを捉えきれず、目覚めは近いのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 거의 아무것에도 매달리지 않습니다. 윤회의 바퀴는 당신을 거의 붙잡지 못하고, 깨달음이 가까이 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du klamrer deg nesten til ingenting. Gjenfødelseshjulet kan knapt holde deg, og oppvåkningen er nær."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niczego się prawie nie trzymasz. Koło odrodzeń ledwie cię utrzymuje, a przebudzenie jest blisko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você quase não se apega a nada. A roda do renascimento mal consegue segurar você, e o despertar está próximo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du håller fast vid nästan ingenting. Återfödelsens hjul kan knappt hålla dig, och uppvaknandet är nära."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你几乎什么都不执着。轮回之轮几乎无法留住你，觉悟已近在咫尺。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你幾乎不執著任何事物。輪迴之輪幾乎難以留住你，覺醒已近在咫尺。"
          }
        }
      }
    },
    "You hold on to almost nothing, and that is what makes you free. The wheel of rebirth can barely grip you.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du holder fast i næsten intet, og netop det gør dig fri. Genfødselshjulet kan knap nok få fat i dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hältst an fast nichts fest, und genau das macht dich frei. Das Rad der Wiedergeburt kann dich kaum packen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te aferras a casi nada, y eso es lo que te hace libre. La rueda del renacimiento apenas puede sujetarte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et pidä juuri mistään kiinni, ja juuri se tekee sinusta vapaan. Jälleensyntymisen pyörä tuskin saa sinusta otetta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne retenez presque rien, et c'est ce qui vous rend libre. La roue de la renaissance a du mal à vous saisir."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú heldur fast í nánast ekkert, og það er það sem gerir þig frjálsan. Hjól endurfæðingarinnar nær varla taki á þér."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non trattieni quasi nulla, ed è questo che ti rende libero. La ruota della rinascita fatica a stringerti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんど何にも執着せず、それゆえ自由です。輪廻の車輪はあなたをほとんど掴めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 거의 아무것도 붙잡지 않고, 그래서 자유로워요. 윤회의 바퀴도 당신을 제대로 붙잡지 못해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du holder fast på nesten ingenting, og det er det som gjør deg fri. Gjenfødelsens hjul kan knapt få tak i deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prawie niczego się nie trzymasz i właśnie to czyni cię wolnym. Koło odrodzeń ledwie cię chwyta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não se apega a quase nada, e é isso que o torna livre. A roda do renascimento mal consegue prender você."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du håller fast vid nästan ingenting, och just det gör dig fri. Återfödelsens hjul kan knappt få tag i dig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你几乎什么都不执着，正因如此你才自由。轮回之轮几乎无法抓住你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你幾乎不緊抓任何事物，正因如此你才自由。輪迴之輪幾乎難以捉住你。"
          }
        }
      }
    },
    "You would give your last coin to a stranger on the shore. Every underworld needs someone carrying a light.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ville give din sidste mønt til en fremmed på bredden. Enhver underverden har brug for nogen, der bærer et lys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du würdest deine letzte Münze einem Fremden am Ufer geben. Jede Unterwelt braucht jemanden, der ein Licht trägt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Darías tu última moneda a un desconocido en la orilla. Todo inframundo necesita a alguien que lleve una luz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Antaisit viimeisen kolikkosi rannalla tuntemattomalle. Jokainen alamaailma tarvitsee jonkun, joka kantaa valoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous donneriez votre dernière pièce à un inconnu sur la rive. Tout monde souterrain a besoin de quelqu'un qui porte une lumière."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú myndir gefa síðasta peninginn þinn ókunnugum manni á bakkanum. Sérhver undirheimur þarf einhvern sem ber ljós."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Daresti la tua ultima moneta a uno sconosciuto sulla riva. Ogni mondo sotterraneo ha bisogno di qualcuno che porti una luce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "岸辺の見知らぬ人に最後の一枚を差し出すでしょう。どんな冥界にも、明かりを運ぶ者が必要なのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 강가의 낯선 이에게 마지막 동전이라도 건넬 사람이에요. 모든 저승에는 빛을 들고 가는 누군가가 필요하니까요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ville gitt din siste mynt til en fremmed på bredden. Enhver underverden trenger noen som bærer et lys."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnią monetę oddasz obcemu na brzegu. Każdy świat podziemny potrzebuje kogoś, kto niesie światło."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você daria sua última moeda a um desconhecido na margem. Todo submundo precisa de alguém que carregue uma luz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skulle ge din sista slant till en främling på stranden. Varje underjord behöver någon som bär ett ljus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会把最后一枚硬币给岸边的陌生人。每个冥界都需要有人提灯照路。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你會把最後一枚硬幣給岸邊的陌生人。每個冥界都需要有人提燈前行。"
          }
        }
      }
    },
    "You would haggle with the ferryman and ask to speak to his manager. Hermes, patron of tricksters, approves.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ville prutte med færgemanden og bede om at få tale med hans chef. Hermes, skælmenes skytsgud, godkender det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du würdest mit dem Fährmann feilschen und seinen Chef sprechen wollen. Hermes, Schutzpatron der Schelme, billigt das."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regatearías con el barquero y pedirías hablar con su jefe. Hermes, patrón de los embaucadores, lo aprueba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinkisit lautturin kanssa ja pyytäisit puhumaan hänen esimiehensä kanssa. Hermes, kujeilijoiden suojelija, hyväksyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous marchanderiez avec le passeur et demanderiez à parler à son responsable. Hermès, patron des farceurs, approuve."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú myndir prútta við ferjumanninn og biðja um að tala við yfirmann hans. Hermes, verndari bragðarefa, myndi samþykkja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrateresti con il traghettatore e chiederesti di parlare con il suo responsabile. Ermes, patrono dei burloni, approva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "渡し守と値切り交渉をし、責任者を出せと言うでしょう。詐術の守護神ヘルメスも、きっと喜びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 뱃사공과 값을 흥정하고 책임자와 이야기하자고 할 사람이에요. 속임수꾼들의 수호신 헤르메스도 좋아할 거예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ville forhandlet med fergemannen og bedt om å få snakke med sjefen hans. Hermes, lurendreiernes beskytter, godkjenner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Targujesz się z przewoźnikiem i żądasz rozmowy z jego przełożonym. Hermes, patron oszustów, to aprobuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você negociaria com o barqueiro e pediria para falar com o gerente dele. Hermes, patrono dos trapaceiros, aprova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skulle pruta med färjkarlen och be att få tala med hans chef. Hermes, bedragarnas beskyddare, godkänner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会和船夫讨价还价，还要求见他的经理。狡黠者的守护神赫尔墨斯会赞许你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你會與擺渡人討價還價，還要求見他的主管。詭計之神赫爾墨斯會讚許你。"
          }
        }
      }
    },
    "You would rather pay for the truth than live on a lie. Hearts like yours are why the feather of Ma'at exists.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ville hellere betale for sandheden end leve i en løgn. Hjerter som dit er grunden til, at Ma'ats fjer findes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du zahlst lieber für die Wahrheit, als mit einer Lüge zu leben. Herzen wie deines sind der Grund, warum es die Feder der Ma'at gibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferirías pagar por la verdad antes que vivir de una mentira. Corazones como el tuyo son la razón de que exista la pluma de Ma'at."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksaisit mieluummin totuudesta kuin elät valheessa. Sinun kaltaisesi sydämet ovat syy, miksi Ma'atin sulka on olemassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous préféreriez payer pour la vérité plutôt que vivre d'un mensonge. Des cœurs comme le vôtre sont la raison d'être de la plume de Ma'at."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú myndir frekar borga fyrir sannleikann en lifa í lygi. Slík hjörtu eru ástæða þess að fjöður Ma'at er til."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferiresti pagare per la verità piuttosto che vivere di menzogna. Cuori come il tuo sono il motivo per cui esiste la piuma di Ma'at."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "嘘の上に生きるくらいなら、真実に代価を払う方を選ぶ人です。あなたのような心があるからこそ、マアトの羽根が存在するのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 거짓으로 사느니 진실에 값을 치르겠다고 하겠지요. 당신 같은 심장 때문에 마아트의 깃털이 있는 거예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ville heller betalt for sannheten enn levd i en løgn. Hjerter som ditt er grunnen til at Ma'ats fjær finnes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wolisz zapłacić za prawdę, niż żyć kłamstwem. Serca takie jak twoje są powodem, dla którego istnieje pióro Ma'at."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você preferiria pagar pela verdade a viver de uma mentira. Corações como o seu são a razão de a pena de Ma'at existir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skulle hellre betala för sanningen än leva i en lögn. Hjärtan som ditt är anledningen till att Ma'ats fjäder finns."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你宁愿为真相付出代价，也不愿靠谎言生活。像你这样的心，正是玛阿特之羽存在的缘由。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你寧願付出代價換取真相，也不願活在謊言裡。像你這樣的心，正是瑪特之羽存在的理由。"
          }
        }
      }
    },
    "You would swim the Styx before paying the toll. The halls of the brave keep a seat for you.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ville svømme over Styx, før du betalte færgepengene. De tappres haller har en plads til dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du würdest den Styx lieber durchschwimmen, als den Zoll zu zahlen. In den Hallen der Tapferen ist ein Platz für dich frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadarías el Estigia antes que pagar el peaje. Los salones de los valientes te guardan un asiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uisit Styxin yli ennen kuin maksaisit tullin. Urhoollisten saleissa on sinulle paikka."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous traverseriez le Styx à la nage plutôt que de payer le péage. Les salles des braves gardent une place pour vous."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú myndir synda yfir Styx frekar en að borga gjaldið. Salir hinna hugrökku geyma sæti handa þér."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuoteresti lo Stige piuttosto che pagare il pedaggio. Le sale dei coraggiosi tengono un posto per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "渡し賃を払うくらいなら、ステュクスを泳いで渡る人です。勇者の館には、あなたのための席があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 통행료를 내느니 스틱스를 헤엄쳐 건너겠지요. 용사들의 전당에는 당신을 위한 자리가 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ville svømme over Styx før du betalte avgiften. De modiges saler har en plass til deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wolisz przepłynąć Styks, niż zapłacić myto. Sale dzielnych mają dla ciebie miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você nadaria o Estige antes de pagar o pedágio. Os salões dos bravos guardam um lugar para você."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skulle hellre simma över Styx än betala tullen. De modigas salar håller en plats åt dig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你宁愿游过冥河也不愿付过路费。勇者的殿堂为你留着一个座位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你寧可游過冥河，也不願付過路費。勇士的殿堂為你保留了座位。"
          }
        }
      }
    },
    "You would take the road no one comes back from, just to see. The Mysteries were made for souls like yours.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ville tage vejen, som ingen vender tilbage fra, bare for at se. Mysterierne er skabt til sjæle som din."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du würdest den Weg, von dem niemand zurückkehrt, nur aus Neugier gehen. Die Mysterien sind für Seelen wie deine gemacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomarías el camino del que nadie regresa, solo por ver. Los Misterios se hicieron para almas como la tuya."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulkisit tietä, jolta kukaan ei palaa, pelkästä uteliaisuudesta. Mysteerit on tehty sinun kaltaisillesi sieluille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous prendriez la route dont nul ne revient, rien que pour voir. Les Mystères ont été faits pour des âmes comme la vôtre."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú myndir fara veginn sem enginn snýr aftur af, bara til að sjá. Leyndardómarnir voru gerðir fyrir sálir eins og þínar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenderesti la strada da cui nessuno torna, solo per vedere. I Misteri sono fatti per anime come la tua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ただ見届けるために、誰も戻らない道を行くでしょう。秘儀は、あなたのような魂のために設けられたのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 아무도 돌아오지 않는 길이라도 직접 보려고 들어설 사람이에요. 신비의식은 당신 같은 영혼을 위해 있는 거예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ville ta veien ingen vender tilbake fra, bare for å se. Mysteriene er laget for sjeler som din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pójdziesz drogą, z której nikt nie wraca, choćby po to, by zobaczyć. Misteria stworzono dla dusz takich jak twoja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você seguiria a estrada de onde ninguém volta, só para ver. Os Mistérios foram feitos para almas como a sua."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skulle ta vägen som ingen återvänder från, bara för att se. Mysterierna skapades för själar som din."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你愿意走上无人归返的路，只为一探究竟。秘仪正是为你这样的灵魂而设。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你會走上無人歸返的道路，只為親眼看看。奧秘正是為像你這樣的靈魂而設。"
          }
        }
      }
    },
    "Your Premium Week Has Ended": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Premium-uge er slut"
          }
        },
        "de": {
