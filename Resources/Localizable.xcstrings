    "Tell it gently, and help carry the cost": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag es sanft und hilf, die Last zu tragen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilo con delicadeza y ayuda a cargar con el coste"
