          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Palabras para llevarte"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanoja mukaasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mots à garder en mémoire"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Orð til að bera með sér"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parole da portare con te"
          }
        },
        "ja": {
          "stringUnit": {
