    "Craving pulls you among the hungry ghosts, with throats like needles and bellies like mountains.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begæret trækker dig ind blandt de sultne ånder, med halse som nåle og maver som bjerge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gier zieht dich unter die Hungrigen Geister, mit Kehlen wie Nadeln und Bäuchen wie Berge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ansia te arrastra entre los fantasmas hambrientos, con gargantas como agujas y vientres como montañas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Himo vetää sinut nälkäisten haamujen joukkoon, joilla on neulanohuet kurkut ja vuoren kokoiset vatsat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le désir vous entraîne parmi les esprits affamés, à la gorge fine comme une aiguille et au ventre gros comme une montagne."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þráin dregur þig meðal svangra drauga, með kverkar eins og nálar og kviði eins og fjöll."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La brama ti trascina tra gli spiriti affamati, con gole come aghi e ventri come montagne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "渇愛があなたを餓鬼の群れへと引き込みます。針のように細い喉と、山のように膨らんだ腹を持つ者たちです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갈망이 당신을 아귀들 사이로 끌어당깁니다. 목구멍은 바늘 같고 배는 산 같은 존재들입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begjær drar deg blant de sultne åndene, med struper som nåler og buker som fjell."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pragnienie ciągnie cię wśród głodnych duchów, o gardłach cienkich jak igły i brzuchach wielkich jak góry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desejo arrasta você entre os fantasmas famintos, de gargantas finas como agulhas e barrigas como montanhas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Begär drar dig bland de hungriga andarna, med halsar som nålar och magar som berg."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贪欲将你拉入饿鬼之中，咽喉如针，腹部如山。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貪欲將你拉入餓鬼道，咽喉細如針，腹部大如山。"
          }
        }
      }
    },
