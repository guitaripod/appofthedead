    "Places I went, things I learned": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Steder, jeg har været, og ting, jeg har lært"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orte, die ich besucht, Dinge, die ich gelernt habe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugares a los que fui, cosas que aprendí"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikat, joissa kävin, asiat, jotka opin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lieux visités, choses apprises"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Staðir sem ég heimsótti, hlutir sem ég lærði"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Luoghi visitati, cose imparate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行った場所、学んだこと"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가 본 곳, 배운 것들"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Steder jeg dro, ting jeg lærte"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsca odwiedzone, rzeczy poznane"
          }
        },
