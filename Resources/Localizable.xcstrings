    "Truths I told when lying was easier": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wahrheiten, die ich sagte, obwohl Lügen leichter gewesen wäre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdades que dije cuando mentir era más fácil"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérités dites alors que mentir était plus facile"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verità che ho detto quando mentire era più facile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "嘘をつく方が楽だったのに語った真実"
