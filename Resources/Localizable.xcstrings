    "Not this time. Your streak lives on.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke denne gang. Din række fortsætter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesmal nicht. Deine Tage-Serie bleibt bestehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vez no. Tu racha sigue viva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei tällä kertaa. Putkesi jatkuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas cette fois. Votre série continue."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki í þetta skipti. Runan þín lifir áfram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non questa volta. La tua serie continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回はだめでした。連続記録は続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번엔 아니에요. 연속 기록은 계속돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke denne gangen. Rekken din består."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tym razem nie. Twoja seria trwa dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não desta vez. Sua sequência continua."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte den här gången. Din svit lever vidare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次没中。你的连续天数依然保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次沒答對，你的連續天數仍在。"
          }
        }
      }
    },
    "Nothing. I'm ready to let go.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet. Jeg er klar til at slippe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts. Ich bin bereit loszulassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada. Estoy listo para soltarlo todo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei mitään. Olen valmis päästämään irti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien. Lâcher prise me convient."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert. Ég er til í að sleppa takinu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente: è tempo di lasciar andare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も。手放す覚悟はできています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도. 놓아줄 준비가 됐어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting. Jeg er klar til å slippe taket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic. Pora to puścić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada. Estou pronto para soltar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting. Jag är redo att släppa taget."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么都不带。我已准备好放手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "什麼都不要。我已準備好放手。"
          }
        }
      }
    },
