    "None. I make my own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keinen. Ich mache mir meinen eigenen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno. Hago el mío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun. Je trace le mien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna. Me ne faccio una mia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なし。自分で作ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "없어요. 내 길은 내가 만들어요."
          }
        },
        "pl": {
          "stringUnit": {
