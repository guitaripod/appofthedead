    "We understand each other. I'm loyal too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir verstehen uns. Ich bin auch treu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos entendemos. Yo también soy leal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous nous comprenons. Je suis fidèle, moi aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci capiamo. Anch'io sono leale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "わかり合えるもの同士。私も忠実です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우리는 서로를 이해해요. 나도 충실해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozumiemy się. Lojalność to także moja cecha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nós nos entendemos. Também sou leal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们彼此懂得。我也一样忠诚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們彼此懂得。我也一樣忠誠。"
          }
        }
      }
    },
    "Weigh it. I'm not afraid.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiege es. Ich habe keine Angst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pésalo. No tengo miedo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesez-la. Je n'ai pas peur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesalo. Non ho paura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "量ってください。恐れてはいません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달아 보세요. 두렵지 않아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waż. Nie boję się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pese. Não tenho medo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "称吧。我不害怕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "秤吧。我不害怕。"
          }
        }
      }
    },
