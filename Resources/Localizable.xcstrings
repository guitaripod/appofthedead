    "The Judgment named me %@. What does that say about my soul?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Totengericht hat mich %@ genannt. Was sagt das über meine Seele?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Juicio me ha nombrado %@. ¿Qué dice eso de mi alma?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Jugement m'a nommé %@. Qu'est-ce que cela dit de mon âme ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Giudizio mi ha dato il nome %@. Cosa dice della mia anima?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "審判は私を%@と名づけました。私の魂について、それは何を物語っているでしょう？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심판은 나를 %@라고 불렀어요. 그건 내 영혼에 대해 무엇을 말해 줄까요?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sąd nazwał mnie %@. Co to mówi o mojej duszy?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Julgamento me deu o nome %@. O que isso diz sobre a minha alma?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审判给我的称号是%@。这说明了我的灵魂怎样？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審判為我評定了%@。這說明我的靈魂怎樣？"
          }
