    "What every culture believes comes after": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was jede Kultur für das Danach glaubt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que toda cultura cree que viene después"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que chaque culture croit qui vient après"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che ogni cultura crede venga dopo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての文化が信じる、死後に訪れるもの"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 문화가 믿어 온 죽음 뒤의 세계"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co według każdej kultury nadchodzi potem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que toda cultura acredita vir depois"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各种文化所相信的死后世界"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每種文化所相信的死後世界"
          }
        }
      }
    },
