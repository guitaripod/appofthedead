    "Continue your journey through the afterlife. Come explore today's lesson!": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt din rejse gennem livet efter døden. Kom og udforsk dagens lektion!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze deine Reise durchs Jenseits fort. Entdecke die heutige Lektion!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue tu viaje por el más allá. ¡Descubre la lección de hoy!"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka matkaasi kuoleman jälkeisessä elämässä. Tutustu tämän päivän oppituntiin!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poursuivez votre voyage dans l'au-delà. Découvrez la leçon du jour !"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Haltu áfram ferð þinni um lífið eftir dauðann. Komdu og kannaðu kennslustund dagsins!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosegui il tuo viaggio nell'aldilà. Scopri la lezione di oggi!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "死後の世界をめぐる旅を続けましょう。今日のレッスンを開きませんか。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사후 세계를 향한 여정을 이어가세요. 오늘의 레슨이 기다립니다!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett reisen gjennom livet etter døden. Kom og utforsk dagens leksjon!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuuj podróż przez zaświaty. Odkryj dzisiejszą lekcję!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue sua jornada pela vida após a morte. Venha ver a lição de hoje!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt din resa genom livet efter döden. Utforska dagens lektion!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续你穿越死后世界的旅程。来看看今天的课程吧！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續你穿越死後世界的旅程。來看看今天的課程吧！"
          }
        }
      }
    },
