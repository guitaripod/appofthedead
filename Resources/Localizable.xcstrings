        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 %@에게 내세에 대해 물었어요. %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg spurte %@ om livet etter døden. %@"
          }
