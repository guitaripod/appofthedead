    "Stay silent. Silence isn't lying.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schweig. Schweigen ist keine Lüge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calla. El silencio no es mentir."
          }
        },
