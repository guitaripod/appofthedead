    "Master Test unlocked! Score 80% or higher to earn the crown badge.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesterprøven er låst op! Opnå 80 % og derover for at få kronemærket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meisterprüfung freigeschaltet! Erreiche 80 % oder mehr für das Kronen-Abzeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Prueba de maestría desbloqueada! Consigue un 80 % o más para ganar la corona."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mestarikoe avattu! Saavuta vähintään 80 % oikein ansaitaksesi kruunumerkin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épreuve de maîtrise débloquée ! Obtenez 80 % ou plus pour gagner la couronne."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Meistarapróf opnað! Fáðu 80% og yfir til að vinna þér inn krúnumerkið."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova di maestria sbloccata! Raggiungi l'80 % o più per ottenere la corona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスターテストが解放されました。80%以上で王冠バッジを獲得できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마스터 시험이 열렸습니다! 80% 이상을 받으면 왕관 배지를 얻습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesterprøven er låst opp! Få 80% og over for å tjene kronemerket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Test mistrzowski odblokowany! Zdobądź 80% lub więcej, aby zdobyć odznakę korony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova de maestria liberada! Acerte 80% ou mais para ganhar o distintivo da coroa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mästarprovet är upplåst! Få 80% och över för att vinna kronmärket."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大师测验已解锁！达到 80% 或以上即可赢得王冠徽章。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大師測驗已解鎖！達到 80% 以上即可贏得王冠徽章。"
          }
        }
      }
    },
