        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O desbloquea solo %1$@ por %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou débloquez seulement %1$@ pour %2$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure sblocca solo %1$@ per %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "または %2$@ で %1$@ のみを解放"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 %2$@에 %1$@만 잠금 해제"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lub odblokuj tylko %1$@ za %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou desbloqueie só %1$@ por %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或仅以 %2$@ 解锁 %1$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "或僅以 %2$@ 解鎖 %1$@"
          }
        }
      }
    },
    "%@ is silent on this. Ask it another way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ schweigt dazu. Frag auf eine andere Weise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ guarda silencio sobre esto. Pregúntale de otra forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reste silencieux sur ce point. Demandez autrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tace su questo. Chiedi in un altro modo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこれについて沈黙しています。別の聞き方で尋ねてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 질문에 대해서는 %@의 답이 없어요. 다르게 물어보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ milczy w tej sprawie. Zapytaj inaczej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não responde a isso. Pergunte de outro jeito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 对此保持沉默。换个方式再问一次吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 對此保持沉默。換個方式再問一次。"
          }
        }
      }
    },
