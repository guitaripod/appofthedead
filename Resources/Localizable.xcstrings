    "Rhadamanthus sends you to the Elysian Fields, the meadows of heroes and of those initiated into the Mysteries.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rhadamanthys schickt dich auf die Elysischen Gefilde, die Wiesen der Helden und jener, die in die Mysterien eingeweiht wurden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Radamantis te envía a los Campos Elíseos, los prados de los héroes y de los iniciados en los Misterios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rhadamanthe vous envoie aux Champs Élysées, les prairies des héros et de ceux qui ont été initiés aux Mystères."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Radamanto ti manda ai Campi Elisi, i prati degli eroi e di chi è stato iniziato ai Misteri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラダマンテュスが、英雄たちと秘儀に入った者たちの野、エリュシオンへあなたを送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라다만토스가 당신을 엘리시온 들판으로 보냅니다. 영웅들과 신비의식에 입문한 이들이 머무는 초원입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Radamantys wysyła cię na Pola Elizejskie, łąki bohaterów i wtajemniczonych w misteria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Radamanto envia você aos Campos Elísios, os prados dos heróis e dos iniciados nos Mistérios."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉达曼提斯将你送往极乐原，那里是英雄与入教秘仪者的草地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拉達曼迪斯將你送往極樂原，那是英雄與入會者的草原。"
          }
        }
      }
    },
