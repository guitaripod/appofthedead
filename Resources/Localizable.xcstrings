    "Fallen warriors escort the sun across the sky for four years, then return to the earth as hummingbirds.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Faldne krigere eskorterer solen over himlen i fire år og vender derefter tilbage til jorden som kolibrier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefallene Krieger geleiten die Sonne vier Jahre lang über den Himmel und kehren dann als Kolibris zur Erde zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los guerreros caídos escoltan al sol por el cielo durante cuatro años y luego vuelven a la tierra como colibríes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaatuneet soturit saattavat aurinkoa taivaan halki neljä vuotta ja palaavat sitten maan päälle kolibreina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les guerriers tombés escortent le soleil dans le ciel pendant quatre ans, puis retournent sur terre sous forme de colibris."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fallnir stríðsmenn fylgja sólinni yfir himininn í fjögur ár og snúa síðan aftur til jarðar sem kólibrífuglar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I guerrieri caduti scortano il sole attraverso il cielo per quattro anni, poi tornano sulla terra come colibrì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "倒れた戦士たちは四年間、太陽を空の向こうまで導き、そのあと地上へハチドリとなって戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰러진 전사들은 4년 동안 해를 호위하며 하늘을 건넌 뒤, 벌새가 되어 지상으로 돌아옵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Falne krigere eskorterer solen over himmelen i fire år, og vender så tilbake til jorden som kolibrier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polegli wojownicy towarzyszą słońcu na niebie przez cztery lata, po czym wracają na ziemię jako kolibry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guerreiros caídos escoltam o sol pelo céu por quatro anos e depois retornam à terra como beija-flores."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stupade krigare eskorterar solen över himlen i fyra år och återvänder sedan till jorden som kolibrier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阵亡的战士护送太阳穿越天空四年，然后化作蜂鸟重返大地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "陣亡的戰士陪伴太陽穿越天空四年，然後化為蜂鳥回到大地。"
          }
        }
      }
    },
    "Far out at sea": {
