    "Your progress will not be saved if you exit now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fortschritt wird nicht gesichert, wenn du jetzt beendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sales ahora, no se guardará tu progreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre progression ne sera pas enregistrée si vous quittez maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se esci ora, i tuoi progressi non verranno salvati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今終了すると、進捗は保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 나가면 진행 상황이 저장되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
