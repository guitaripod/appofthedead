        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie sollen die Schriftrollen dich festhalten?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo te registrarán los pergaminos?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miten sinut kirjataan kääröihin?"
