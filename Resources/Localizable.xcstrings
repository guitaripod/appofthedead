    "Your word outlives you. In every tradition here, a kept promise weighs more than gold.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wort überdauert dich. In jeder Tradition hier wiegt ein gehaltenes Versprechen mehr als Gold."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu palabra te sobrevive. En todas las tradiciones de aquí, una promesa cumplida pesa más que el oro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre parole vous survit. Dans chacune de ces traditions, une promesse tenue pèse plus que l'or."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua parola ti sopravvive. In ogni tradizione qui, una promessa mantenuta pesa più dell'oro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの言葉は、あなたより長く生きます。ここに挙げたどの伝統においても、守られた約束は黄金より重いのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 말은 당신보다 오래 남습니다. 여기 모든 전통에서 지킨 약속은 금보다 무겁습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje słowo przeżyje ciebie. We wszystkich tych tradycjach dotrzymana obietnica waży więcej niż złoto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua palavra sobrevive a você. Em todas as tradições aqui, uma promessa cumprida pesa mais que ouro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的话语比你活得更久。在这里的每一种传统中，践守的承诺都比黄金更重。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的話語將比你存活得更久。在這裡每一種信仰中，守住的承諾都比黃金更重。"
          }
        }
      }
    },
