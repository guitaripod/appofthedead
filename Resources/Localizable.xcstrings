    "You got %lld out of %lld correct (%lld%%). Earned %lld XP!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld richtig (%3$lld%%). %4$lld XP verdient!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has acertado %1$lld de %2$lld (%3$lld%%). ¡%4$lld XP ganados!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld bonnes réponses sur %2$lld (%3$lld%%). %4$lld XP gagnés !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai indovinato %1$lld su %2$lld (%3$lld%%). %4$lld XP guadagnati!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld問中%1$lld問正解（%3$lld%%）。%4$lld XP を獲得しました！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld문제 중 %1$lld문제를 맞혔습니다(%3$lld%%). %4$lld XP 획득!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz %1$lld z %2$lld poprawnych (%3$lld%%). Zdobyto %4$lld XP!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você acertou %1$lld de %2$lld (%3$lld%%). Ganhou %4$lld XP!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你答对了 %2$lld 题中的 %1$lld 题（%3$lld%%），获得 %4$lld XP！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你答對了 %2$lld 題中的 %1$lld 題（%3$lld%%），獲得 %4$lld XP！"
          }
        }
      }
    },
