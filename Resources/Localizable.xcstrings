        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdades que contei quando mentir era mais fácil"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在撒谎更容易时，我仍说出的真话"
