    "Haggle. Everyone has a price.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feilschen. Jeder hat seinen Preis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regatea. Todo el mundo tiene un precio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchander. Tout le monde a un prix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contratta. Ognuno ha il suo prezzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値切る。誰にだって値段はある。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값을 흥정한다. 누구에게나 값은 있다."
