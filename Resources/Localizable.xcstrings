        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@days@, síðan %2$@ á ári. Endurnýjast sjálfkrafa þar til þú segir upp í Stillingum að minnsta kosti einum degi fyrir hverja endurnýjun."
          },
          "substitutions": {
            "days": {
              "argNum": 1,
              "formatSpecifier": "lld",
