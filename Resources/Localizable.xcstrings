    "I ask her where each one leads": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich frage sie, wohin jeder führt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pregunto a dónde lleva cada uno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lui demande où mène chacune"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiedo dove porta ciascuna"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それぞれの道がどこへ通じるか、彼女に尋ねる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그녀에게 각 길이 어디로 이어지는지 물어요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytam ją, dokąd prowadzi każda z nich"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunto a ela para onde cada uma leva"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我问她每条路通往何处"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我問她每條路通往何處"
          }
        }
      }
    },
    "I asked %@ about the afterlife. %@": {
