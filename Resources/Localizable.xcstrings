    "Give it to the weeping shade behind me": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv den til den grædende skygge bag mig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib es dem weinenden Schatten hinter mir"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dáselo a la sombra llorosa que tengo detrás"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna se takanani itkevälle varjolle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donner la pièce à l'ombre en pleurs derrière moi"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefðu það grátandi skugganum fyrir aftan mig"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dallo all'ombra piangente dietro di me"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後ろで泣いている影に渡す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤에서 우는 그림자에게 준다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi den til den gråtende skyggen bak meg"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oddaj to płaczącemu cieniowi za mną"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar à sombra chorosa atrás de mim"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge det till den gråtande skuggan bakom mig"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把它给我身后那位哭泣的幽魂"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把它給我身後哭泣的幽魂"
          }
        }
      }
    },
