            "state": "translated",
            "value": "免费试用将在 2 天后结束"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費試用將在 2 天後結束"
          }
        }
      }
    },
    "Your progress will not be saved if you exit now.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine fremskridt gemmes ikke, hvis du afslutter nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fortschritt wird nicht gesichert, wenn du jetzt beendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sales ahora, no se guardará tu progreso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Edistymistäsi ei tallenneta, jos poistut nyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre progression ne sera pas enregistrée si vous quittez maintenant."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Framvindan þín verður ekki vistuð ef þú hættir núna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se esci ora, i tuoi progressi non verranno salvati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今終了すると、進捗は保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 나가면 진행 상황이 저장되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fremgangen din lagres ikke hvis du avslutter nå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój postęp nie zostanie zapisany, jeśli teraz wyjdziesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu progresso não será salvo se você sair agora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina framsteg sparas inte om du avslutar nu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在退出将不会保存你的进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在離開將不會儲存你的進度。"
          }
        }
      }
    },
    "Your purchase is waiting for approval. It unlocks by itself once it is approved.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit køb venter på godkendelse. Det låses op af sig selv, når det er godkendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf wartet auf Genehmigung. Er wird automatisch freigeschaltet, sobald er genehmigt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está esperando aprobación. Se desbloquea sola en cuanto se apruebe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostosi odottaa hyväksyntää. Se avautuu itsestään, kun se on hyväksytty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat est en attente d'approbation. Il se débloque tout seul dès qu'il est approuvé."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaupið þitt bíður samþykkis. Það opnast sjálfkrafa þegar það hefur verið samþykkt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo acquisto è in attesa di approvazione. Si sblocca da solo non appena viene approvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。承認されると自動的に利用できるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매가 승인을 기다리고 있습니다. 승인되면 자동으로 잠금이 해제됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet ditt venter på godkjenning. Det låses opp av seg selv når det er godkjent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój zakup czeka na zatwierdzenie. Odblokuje się samoczynnie po zatwierdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra está aguardando aprovação. Ela é liberada sozinha assim que for aprovada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt köp väntar på godkännande. Det låses upp automatiskt när det har godkänts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的购买正在等待批准。批准后将自动解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的購買正在等待核准。核准後將自動解鎖。"
          }
        }
      }
    },
    "Your purchases could not be restored. Please try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine køb kunne ikke gendannes. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Käufe konnten nicht wiederhergestellt werden. Bitte versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron restaurar tus compras. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostojasi ei voitu palauttaa. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos achats n'ont pas pu être restaurés. Veuillez réessayer."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að endurheimta kaupin þín. Reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile ripristinare i tuoi acquisti. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を復元できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매를 복원할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpene dine kunne ikke gjenopprettes. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się przywrócić zakupów. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível restaurar suas compras. Tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina köp kunde inte återställas. Försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复你的购买项目。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法還原你的購買項目。請再試一次。"
          }
        }
      }
    },
