    "Pride carries you to the asuras, demigods forever at war with the gods.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stolthed fører dig til asuraerne, halvguder, der evigt er i krig med guderne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stolz trägt dich zu den Asuras, Halbgöttern, die ewig mit den Göttern im Krieg liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El orgullo te lleva a los asuras, semidioses en guerra eterna con los dioses."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ylpeys kuljettaa sinut asuroille, puolijumalille, jotka sotivat ikuisesti jumalia vastaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'orgueil vous mène chez les asuras, demi-dieux à jamais en guerre contre les dieux."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hroki ber þig til asúranna, hálfguða sem eru að eilífu í stríði við guðina."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'orgoglio ti porta tra gli asura, semidei in guerra eterna con gli dèi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "驕りがあなたを阿修羅へと運びます。神々と永遠に争い続ける半神の世界です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교만이 당신을 아수라에게로 데려갑니다. 신들과 늘 싸우는 반신들입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stolthet bærer deg til asurene, halvguder som evig ligger i krig med gudene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duma prowadzi cię do asurów, półbogów wiecznie walczących z bogami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O orgulho leva você aos asuras, semideuses para sempre em guerra com os deuses."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stolthet tar dig till asurerna, halvgudar som för evigt står i krig mot gudarna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "骄慢将你带往阿修罗界，那些半神永远与诸神交战。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驕傲將你帶往阿修羅道，那是永遠與諸神交戰的半神。"
          }
        }
      }
    },
