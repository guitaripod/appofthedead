    "Oath-breakers wade to Náströnd, the Corpse Shore, where the dragon Níðhöggr gnaws the dead.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eedsbrydere vader ud til Náströnd, Likkysten, hvor dragen Níðhöggr gnaver de døde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eidbrecher waten nach Náströnd, dem Leichenstrand, wo der Drache Níðhöggr die Toten benagt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perjuros vadean hasta Náströnd, la Orilla de los Cadáveres, donde el dragón Níðhöggr roe a los muertos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valapatot kahlaavat Náströndiin, ruumisrannalle, jossa lohikäärme Níðhöggr jyrsii kuolleita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parjures traversent à gué jusqu'à Náströnd, la Rive des cadavres, où le dragon Níðhöggr ronge les morts."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eiðrofar vaða til Náströndar, Líkaströndarinnar, þar sem drekinn Níðhöggur nagar hina dánu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli spergiuri guadano fino a Náströnd, la Riva dei Cadaveri, dove il drago Níðhöggr rode i morti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誓いを破った者たちは、死体の岸ナーストルンドへ歩いて渡ります。そこでは竜ニーズヘッグが死者を齧っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맹세를 어긴 자들은 시체의 해변 나스트룬드까지 물을 헤치고 갑니다. 그곳에서 용 니드회그가 죽은 자를 갉아 먹습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Edsbrytere vader mot Náströnd, likstranden, der dragen Níðhöggr gnager på de døde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krzywoprzysiężcy brodzą ku Náströnd, Brzegowi Zwłok, gdzie smok Níðhöggr podgryza zmarłych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os quebradores de juramento atravessam até Náströnd, a Praia dos Cadáveres, onde o dragão Níðhöggr rói os mortos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Edsbrytare vadar till Náströnd, Likstranden, där draken Níðhöggr gnager på de döda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背誓者涉水前往纳斯特隆德，即尸岸，那里有巨龙尼德霍格啃噬亡者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "違背誓言者涉水走向納斯特朗德，即屍之岸，那裡有龍尼德霍格啃食亡者。"
          }
        }
      }
    },
