    "All 21 paths, unlimited Oracle and every path still to come": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 21 veje, ubegrænset orakel og alle kommende veje"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 21 Pfade, das Orakel ohne Limit und jeder kommende Pfad"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los 21 caminos, el Oráculo sin límites y cada camino que llegue"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki 21 polkua, rajaton oraakkeli ja kaikki tulevat polut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 21 voies, l'Oracle illimité et chaque voie à venir"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Allar 21 leiðir, ótakmörkuð véfrétt og allar leiðir sem bætast við"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i 21 percorsi, l'Oracolo illimitato e ogni percorso in arrivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "21の道すべて、無制限のオラクル、今後の新しい道も"
