    "Midgar's server forgets your anonymous ID and the purchase records linked to it. Your purchases stay with your Apple Account. This can't be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Midgars Server vergisst deine anonyme ID und die damit verknüpften Kaufdaten. Deine Käufe bleiben bei deinem Apple Account. Dies lässt sich nicht rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de Midgar oublie votre identifiant anonyme et les enregistrements d'achat qui lui sont liés. Vos achats restent liés à votre compte Apple. Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de Midgar olvida tu ID anónimo y los registros de compra vinculados a él. Tus compras siguen en tu cuenta de Apple. Esta acción no se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server di Midgar dimentica il tuo ID anonimo e i relativi record di acquisto. I tuoi acquisti restano nel tuo Apple Account. L'operazione non può essere annullata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor da Midgar esquece seu ID anônimo e os registros de compra vinculados a ele. Suas compras continuam na sua Conta Apple. Isso não pode ser desfeito."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer Midgar zapomina Twój anonimowy ID oraz powiązane z nim rekordy zakupów. Zakupy pozostają na Twoim Koncie Apple. Tej operacji nie można cofnąć."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Midgar のサーバーから、匿名の ID とそれに紐づく購入記録が消去されます。購入内容は Apple アカウントに残ります。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Midgar 서버에서 익명 ID와 여기에 연결된 구매 기록이 지워집니다. 구매 항목은 Apple 계정에 그대로 남습니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Midgar 服务器将忘记你的匿名 ID 及与之关联的购买记录。你的购买项目仍保留在 Apple 账户中。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Midgar 伺服器將刪除你的匿名 ID 及與之相關的購買紀錄。你的購買項目仍保留在 Apple 帳號中。此操作無法復原。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Midgars server glemmer dit anonyme ID og de købsdata, der er knyttet til det. Dine køb bliver hos din Apple-konto. Dette kan ikke fortrydes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Midgarin palvelin unohtaa anonyymin tunnuksesi ja siihen liittyvät ostotiedot. Ostoksesi pysyvät Apple-tililläsi. Tätä ei voi peruuttaa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Netþjónn Midgar gleymir nafnlausa auðkenninu þínu og kaupsögunni sem tengist því. Kaupin þín haldast á Apple-aðgangnum þínum. Þetta er ekki hægt að afturkalla."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Midgars server glemmer din anonyme ID og kjøpsopplysningene knyttet til den. Kjøpene dine forblir på Apple-kontoen din. Dette kan ikke angres."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Midgars server glömmer ditt anonyma ID och de köp som är kopplade till det. Dina köp finns kvar på ditt Apple-konto. Detta kan inte ångras."
          }
        }
      }
    },
