    "Tap a term and the Oracle explains it.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et begreb, og Oraklet forklarer det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Begriff, und das Orakel erklärt ihn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un término y el Oráculo lo explica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta termiä, ja Oraakkeli selittää sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un terme, et l'Oracle l'explique."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýttu á hugtak og Véfréttin útskýrir það."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un termine e l'Oracolo lo spiega."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "用語をタップすると、オラクルが説明します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용어를 누르면 오라클이 설명해 줘요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på et begrep, så forklarer Orakelet det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij pojęcia, a Wyrocznia je wyjaśni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um termo e o Oráculo o explica."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en term så förklarar Oraklet den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按词语，神谕会为你解释。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選詞彙，神諭會為你解釋。"
          }
        }
      }
    },
