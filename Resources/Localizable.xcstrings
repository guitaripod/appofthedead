    "Keep exploring every path and the Oracle, or cancel anytime in Settings. No surprises.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bliv ved med at udforske alle veje og Oraklet, eller opsig når som helst i Indstillinger. Ingen overraskelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkunde weiter jeden Pfad und das Orakel – oder kündige jederzeit in den Einstellungen. Keine Überraschungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue explorando cada camino y el Oráculo, o cancela cuando quieras en Ajustes. Sin sorpresas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka jokaisen polun ja oraakkelin tutkimista tai peruuta milloin tahansa asetuksissa. Ei yllätyksiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez d'explorer chaque voie et l'Oracle, ou résiliez quand vous voulez dans Réglages. Sans surprise."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Haltu áfram að kanna allar leiðir og véfréttina, eða hættu við hvenær sem er í Stillingum. Engin óvænt gjöld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a esplorare ogni percorso e l'Oracolo, oppure annulla quando vuoi in Impostazioni. Nessuna sorpresa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての道とオラクルを使い続けることも、設定でいつでも解約することもできます。不意の請求はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 길과 오라클을 계속 이용하거나, 설정에서 언제든 취소하세요. 예상치 못한 청구는 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett å utforske alle veier og Orakelet, eller si opp når som helst i Innstillinger. Ingen overraskelser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkrywaj dalej każdą ścieżkę i Wyrocznię, albo anuluj w dowolnej chwili w Ustawieniach. Żadnych niespodzianek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue explorando todos os caminhos e o Oráculo, ou cancele quando quiser nos Ajustes. Sem surpresas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt utforska alla vägar och Oraklet, eller avbryt när som helst i Inställningar. Inga överraskningar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续探索每条路径与神谕，也可随时在「设置」中取消。没有意外扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續探索每條路徑與神諭，也可隨時在「設定」中取消。不會有意外扣款。"
          }
        }
      }
    },
