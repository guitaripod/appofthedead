            "state": "translated",
            "value": "Je n'ai fait pleurer personne"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ég hef ekki látið neinn gráta"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ho fatto piangere nessuno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かを泣かせたことはない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 누구도 울게 하지 않았다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har ikke fått noen til å gråte"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt przeze mnie nie płakał"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não fiz ninguém chorar"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag har inte fått någon att gråta"
          }
        },
        "zh-Hans": {
