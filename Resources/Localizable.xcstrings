    "I ask her where each one leads": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg spørger hende, hvor hver enkelt fører hen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich frage sie, wohin jeder führt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pregunto a dónde lleva cada uno"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysyn häneltä, minne kukin tie vie"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lui demande où mène chacune"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ég spyr hana hvert hver þeirra leiðir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiedo dove porta ciascuna"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それぞれの道がどこへ通じるか、彼女に尋ねる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그녀에게 각 길이 어디로 이어지는지 물어요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg spør henne hvor hver enkelt fører"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytam ją, dokąd prowadzi każda z nich"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunto a ela para onde cada uma leva"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag frågar henne vart var och en leder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我问她每条路通往何处"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我問她每條路通往何處"
          }
        }
      }
    },
    "I asked %@ about the afterlife. %@": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg spurgte %@ om livet efter døden. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe %@ nach dem Leben nach dem Tod gefragt. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pregunté a %@ por la vida después de la muerte. %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysyin %@:ltä kuolemanjälkeisestä elämästä. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai demandé à %@ ce qui attend après la mort. %@"
