    "Passing takes %lld%%. Review what you missed and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestået kræver %lld %%. Gennemgå det, du missede, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Bestehen braucht es %lld %%. Wiederhole, was du verpasst hast, und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para aprobar se necesita un %lld %%. Repasa lo que fallaste e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyväksyminen vaatii %lld %%. Kertaa virheesi ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut %lld %% pour réussir. Révisez les erreurs et réessayez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Til að standast þarf %lld%%. Farðu yfir það sem þú misstir og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per superare servono %lld%%. Ripassa ciò che hai sbagliato e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合格には%lld%%が必要です。間違えた箇所を復習して、もう一度挑戦しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "합격 기준은 %lld%%입니다. 틀린 부분을 복습하고 다시 도전하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må få %lld %% for å bestå. Gå gjennom det du bommet på, og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do zaliczenia potrzeba %lld %%. Powtórz to, co pominąłeś, i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para passar é preciso %lld%%. Revise o que você errou e tente de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För godkänt krävs %lld %%. Gå igenom det du missade och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "及格线为%lld%%。复习错题后再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "及格線為%lld%%。複習錯題後再試一次。"
          }
        }
      }
    },
