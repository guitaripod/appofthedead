    "A gentle nudge at %@. You can change the time anytime in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine sanfte Erinnerung um %@. Die Uhrzeit kannst du jederzeit in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso suave a las %@. Puedes cambiar la hora cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit rappel à %@. Vous pouvez changer l'heure à tout moment dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria discreto alle %@. Puoi cambiare l'orario in qualsiasi momento in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にそっとお知らせします。時刻は設定でいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 가볍게 알려 드려요. 시간은 설정에서 언제든 바꿀 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatne przypomnienie o %@. Godzinę możesz zmienić w dowolnej chwili w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete discreto às %@. Você pode mudar o horário a qualquer momento nos Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将在 %@ 轻轻提醒你。你可以随时在「设置」中更改时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將在 %@ 輕輕提醒你。你可以隨時在「設定」中更改時間。"
          }
        }
      }
    },
    "A rating helps the next curious soul find App of the Dead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bewertung hilft der nächsten neugierigen Seele, App of the Dead zu finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une note aide la prochaine âme curieuse à trouver App of the Dead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una valoración ayuda a la próxima alma curiosa a encontrar App of the Dead."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una valutazione aiuta la prossima anima curiosa a trovare App of the Dead."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua avaliação ajuda a próxima alma curiosa a encontrar App of the Dead."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja ocena pomoże kolejnej ciekawej duszy znaleźć App of the Dead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "評価は、次に訪れる好奇心旺盛な魂が App of the Dead を見つける助けになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평점은 다음에 찾아올 호기심 많은 영혼이 App of the Dead를 발견하는 데 도움이 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若你喜欢，一个评分就能帮助下一位好奇的灵魂找到 App of the Dead。"
          }
        },
        "zh-Hant": {
