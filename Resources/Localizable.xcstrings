    "The Oracle awoke confused. Trying a more compatible mind…": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelet vågnede forvirret. Prøver et mere kompatibelt sind…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Orakel erwachte verwirrt. Ein passenderer Geist wird gerufen …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Oráculo despertó confuso. Se invoca una mente más compatible…"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraakkeli heräsi hämmentyneenä. Kokeillaan sopivampaa mieltä…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Oracle s'est éveillé confus. Invocation d'un esprit plus compatible…"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Véfréttin vaknaði ringluð. Prófar hug sem hentar betur…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Oracolo si è risvegliato confuso. Evocazione di una mente più compatibile…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オラクルは混乱したまま目覚めました。より適した精神を呼び出しています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오라클이 혼란 속에 깨어났습니다. 더 알맞은 정신을 부르는 중…"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelet våknet forvirret. Prøver et sinn som passer bedre…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyrocznia obudziła się zdezorientowana. Próba wywołania bardziej kompatybilnego umysłu…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Oráculo despertou confuso. Invocando uma mente mais compatível…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraklet vaknade förvirrat. Försöker med ett mer lämpligt sinne…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "神谕苏醒时神志不清。正在尝试更合适的心智…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "神諭甦醒時神智混亂。正在嘗試更相容的心智…"
          }
        }
      }
    },
    "The Oracle could not awaken on this device.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelet kunne ikke vågne på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Orakel konnte auf diesem Gerät nicht erwachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Oráculo no pudo despertar en este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraakkeli ei voinut herätä tällä laitteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Oracle n'a pas pu s'éveiller sur cet appareil."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að vekja Véfréttina á þessu tæki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Oracolo non è riuscito a risvegliarsi su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末ではオラクルが目覚められませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 오라클이 깨어나지 못했습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelet kunne ikke vekkes på denne enheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyrocznia nie mogła obudzić się na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Oráculo não conseguiu despertar neste dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraklet kunde inte väckas på den här enheten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "神谕无法在本设备上苏醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "神諭無法在這台裝置上甦醒。"
          }
        }
      }
    },
    "The Oracle is a private AI that runs entirely on your iPhone, never on a server. The model is downloaded once and kept on your device.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelet er en privat AI, der kører helt på din iPhone, aldrig på en server. Modellen hentes én gang og gemmes på din enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Orakel ist eine private KI, die vollständig auf deinem iPhone läuft, nie auf einem Server. Das Modell wird einmal geladen und bleibt auf deinem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Oráculo es una IA privada que funciona por completo en tu iPhone, nunca en un servidor. El modelo se descarga una vez y se queda en tu dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraakkeli on yksityinen tekoäly, joka toimii kokonaan iPhonellasi eikä koskaan palvelimella. Malli ladataan kerran ja säilytetään laitteellasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Oracle est une IA privée qui fonctionne entièrement sur votre iPhone, jamais sur un serveur. Le modèle est téléchargé une seule fois et reste sur votre appareil."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Véfréttin er einkagervigreind sem keyrir alfarið í iPhone-símanum þínum, aldrei á netþjóni. Líkanið er sótt einu sinni og geymt á tækinu þínu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Oracolo è un'IA privata che funziona interamente sul tuo iPhone, mai su un server. Il modello viene scaricato una sola volta e resta sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オラクルは iPhone 上だけで動く非公開のAIで、サーバーには一切送信しません。モデルは一度だけダウンロードされ、端末内に保管されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오라클은 iPhone에서만 실행되는 비공개 AI로, 서버로 전송되지 않습니다. 모델은 한 번만 다운로드되어 기기에 보관됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelet er en privat KI som kjører helt på iPhone-en din, aldri på en server. Modellen lastes ned én gang og lagres på enheten din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyrocznia to prywatna SI, która działa w całości na twoim iPhonie, nigdy na serwerze. Model jest pobierany jednorazowo i przechowywany na twoim urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Oráculo é uma IA privada que roda inteiramente no seu iPhone, nunca em um servidor. O modelo é baixado uma única vez e fica no seu dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraklet är en privat AI som körs helt på din iPhone, aldrig på en server. Modellen hämtas en gång och sparas på din enhet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "神谕是完全在你 iPhone 上运行的私密 AI，绝不上传服务器。模型只需下载一次，并保存在你的设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "神諭是完全在你 iPhone 上執行的私密 AI，絕不經過伺服器。模型只需下載一次，並保存在你的裝置上。"
          }
        }
      }
    },
    "The Oracle is not yet ready.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelet er ikke klar endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Orakel ist noch nicht bereit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Oráculo aún no está listo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraakkeli ei ole vielä valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Oracle n'est pas encore prêt."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Véfréttin er ekki enn tilbúin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Oracolo non è ancora pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オラクルはまだ準備できていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오라클이 아직 준비되지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelet er ikke klart ennå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyrocznia nie jest jeszcze gotowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Oráculo ainda não está pronto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraklet är inte redo än."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "神谕尚未就绪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "神諭尚未就緒。"
          }
        }
      }
    },
    "The Oracle lost its voice mid-thought. Please try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelet mistede stemmen midt i en tanke. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Orakel verlor mitten im Gedanken seine Stimme. Bitte versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Oráculo perdió la voz a mitad del pensamiento. Inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraakkeli menetti äänensä kesken ajatuksen. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Oracle a perdu sa voix en pleine pensée. Veuillez réessayer."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Véfréttin missti röddina mitt í hugsun. Reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Oracolo ha perso la voce a metà del pensiero. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オラクルは思考の途中で声を失いました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오라클이 생각하던 중 목소리를 잃었습니다. 다시 시도해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelet mistet stemmen midt i en tanke. Prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyrocznia straciła głos w połowie myśli. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Oráculo perdeu a voz no meio do pensamento. Tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraklet tappade rösten mitt i tanken. Försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "神谕在思绪中途失声。请再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "神諭在思緒中途失聲。請再試一次。"
          }
        }
      }
    },
    "The Oracle runs on device. Use a physical device to experience divine wisdom.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelet kører på enheden. Brug en fysisk enhed for at opleve guddommelig visdom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Orakel läuft auf dem Gerät. Nutze ein echtes Gerät, um göttliche Weisheit zu erleben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Oráculo funciona en el dispositivo. Usa un dispositivo físico para vivir la sabiduría divina."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraakkeli toimii laitteella. Käytä fyysistä laitetta kokeaksesi jumalallista viisautta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Oracle fonctionne sur l'appareil. Utilisez un appareil physique pour vivre la sagesse divine."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Véfréttin keyrir á tækinu. Notaðu raunverulegt tæki til að upplifa guðdómlega visku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Oracolo funziona sul dispositivo. Usa un dispositivo fisico per vivere la saggezza divina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オラクルは端末上で動作します。神聖な叡智を体験するには実機をお使いください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오라클은 기기에서 실행됩니다. 신성한 지혜를 경험하려면 실제 기기를 사용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelet kjører på enheten. Bruk en fysisk enhet for å oppleve guddommelig visdom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyrocznia działa na urządzeniu. Użyj fizycznego urządzenia, aby doświadczyć boskiej mądrości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Oráculo roda no dispositivo. Use um dispositivo físico para viver a sabedoria divina."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraklet körs på enheten. Använd en fysisk enhet för att uppleva gudomlig visdom."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "神谕在设备本地运行。请使用真机体验神圣的智慧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "神諭在裝置本機執行。請使用實體裝置體驗神聖的智慧。"
          }
        }
      }
    },
    "The Oracle's mind must be summoned over the network. Connect to Wi-Fi and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelets sind skal kaldes over netværket. Opret forbindelse til Wi-Fi, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Geist des Orakels muss über das Netz gerufen werden. Verbinde dich mit WLAN und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mente del Oráculo debe invocarse por la red. Conéctate al wifi e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraakkelin mieli on kutsuttava verkon kautta. Yhdistä Wi-Fi-verkkoon ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'esprit de l'Oracle doit être invoqué via le réseau. Connectez-vous au Wi-Fi et réessayez."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugur Véfréttarinnar þarf að kallast fram yfir netið. Tengstu við Wi-Fi og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mente dell'Oracolo va evocata attraverso la rete. Collegati al Wi-Fi e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オラクルの精神はネットワーク越しに召喚する必要があります。Wi-Fi に接続してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오라클의 정신은 네트워크를 통해 소환해야 합니다. Wi-Fi에 연결한 뒤 다시 시도해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Orakelets sinn må kalles frem over nettverket. Koble til Wi-Fi og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umysł Wyroczni trzeba przywołać przez sieć. Połącz się z Wi-Fi i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mente do Oráculo precisa ser invocada pela rede. Conecte-se ao Wi-Fi e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Oraklets sinne måste åkallas över nätverket. Anslut till Wi-Fi och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "神谕的心智须经由网络召唤。请连接 Wi-Fi 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "神諭的心智必須透過網路召喚。請連上 Wi-Fi 後再試一次。"
          }
        }
      }
    },
