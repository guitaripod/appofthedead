    "Your %lld finished lessons stay exactly where you left them. Keep every path and every god open.": {
      "localizations": {
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Din %lld gennemførte lektion bliver præcis, hvor du slap. Hold alle veje og alle guder åbne."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dine %lld gennemførte lektioner bliver præcis, hvor du slap. Hold alle veje og alle guder åbne."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Deine %lld abgeschlossene Lektion bleibt genau dort, wo du aufgehört hast. Halte jeden Pfad und jeden Gott offen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Deine %lld abgeschlossenen Lektionen bleiben genau dort, wo du aufgehört hast. Halte jeden Pfad und jeden Gott offen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your %lld finished lesson stays exactly where you left it. Keep every path and every god open."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Your %lld finished lessons stay exactly where you left them. Keep every path and every god open."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tu %lld lección terminada sigue exactamente donde la dejaste. Mantén abiertos todos los caminos y todos los dioses."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tus %lld lecciones terminadas siguen exactamente donde las dejaste. Mantén abiertos todos los caminos y todos los dioses."
                }
              }
            }
          }
        },
        "fi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Suorittamasi %lld oppitunti säilyy täsmälleen siinä, mihin sen jätit. Pidä kaikki polut ja jumalat auki."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Suorittamasi %lld oppituntia säilyvät täsmälleen siinä, mihin ne jätit. Pidä kaikki polut ja jumalat auki."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Votre %lld leçon terminée reste exactement là où vous l'avez laissée. Gardez ouvertes toutes les voies et tous les dieux."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vos %lld leçons terminées restent exactement là où vous les avez laissées. Gardez ouvertes toutes les voies et tous les dieux."
                }
              }
            }
          }
        },
        "is": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld kennslustund sem þú laukst er nákvæmlega þar sem þú skildir við hana. Haltu öllum leiðum og öllum guðum opnum."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld kennslustundir sem þú laukst eru nákvæmlega þar sem þú skildir við þær. Haltu öllum leiðum og öllum guðum opnum."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "La tua %lld lezione completata resta esattamente dove l'hai lasciata. Tieni aperti ogni percorso e ogni dio."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Le tue %lld lezioni completate restano esattamente dove le hai lasciate. Tieni aperti ogni percorso e ogni dio."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修了した %lld 件のレッスンは、中断したところのまま残ります。すべての道と神々を開いたままにしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마친 레슨 %lld개는 떠났던 자리 그대로 남아 있어요. 모든 길과 모든 신을 계속 열어 두세요."
          }
        },
        "nb": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Den %lld fullførte leksjonen din er akkurat der du slapp den. Behold hver vei og hver gud åpen."
