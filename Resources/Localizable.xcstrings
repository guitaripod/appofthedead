            "value": "Espacio insuficiente. El Oráculo necesita %1$@ libres, pero solo hay %2$@ disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace insuffisant. L'Oracle a besoin de %1$@ libres, or seuls %2$@ sont disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio insufficiente. L'Oracolo richiede %1$@ liberi, ma ne sono disponibili solo %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量が足りません。オラクルには%1$@必要ですが、空きは%2$@です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간이 부족합니다. 오라클에는 %1$@이(가) 필요하지만 %2$@만 남아 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało miejsca. Wyrocznia potrzebuje %1$@ wolnego miejsca, a dostępne jest tylko %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço insuficiente. O Oráculo precisa de %1$@ livres, mas só há %2$@ disponíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间不足。神谕需要 %1$@ 可用空间，但仅剩 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空間不足。神諭需要 %1$@ 可用空間，但目前只剩 %2$@。"
          }
        }
      }
    },
